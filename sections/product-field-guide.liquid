{{ 'component-demo-pages.css' | asset_url | stylesheet_tag }}
{%- capture rows -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.value != blank -%}
      <div class="field-guide__row" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape | newline_to_br }}</dd></div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rows != blank or section.settings.instructions != blank or section.settings.shipping != blank -%}
<section class="waypoint-page page-width" aria-labelledby="FieldGuide-{{ section.id }}">
  <div class="section-header"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 id="FieldGuide-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="field-guide">
    {%- if rows != blank -%}<dl class="field-guide__specs">{{ rows }}</dl>{%- endif -%}
    <div>
      {%- if section.settings.instructions != blank -%}<details class="accordion"><summary class="accordion__trigger">{{ section.settings.instructions_label | escape }}</summary><div class="accordion__content rte">{{ section.settings.instructions }}</div></details>{%- endif -%}
      {%- if section.settings.shipping != blank -%}<details class="accordion"><summary class="accordion__trigger">{{ section.settings.shipping_label | escape }}</summary><div class="accordion__content rte">{{ section.settings.shipping }}</div></details>{%- endif -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}<div class="page-width waypoint-page__empty">Add verified specifications and setup/shipping information. Empty fields are hidden from shoppers. Connect product metafields for product-specific values.</div>{%- endif -%}
{% schema %}
{
 "name":"Product field guide",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Know your gear"},
  {"type":"text","id":"heading","label":"Heading","default":"The details, clearly explained"},
  {"type":"text","id":"instructions_label","label":"Instructions heading","default":"Setup and care"},
  {"type":"richtext","id":"instructions","label":"Verified setup and care instructions"},
  {"type":"text","id":"shipping_label","label":"Shipping heading","default":"Delivery and returns"},
  {"type":"richtext","id":"shipping","label":"Delivery and return information"}
 ],
 "blocks":[{"type":"specification","name":"Specification","settings":[{"type":"text","id":"label","label":"Label"},{"type":"textarea","id":"value","label":"Verified value","info":"Include units. Connect a product metafield when sharing this template across products."}]}],
 "max_blocks":12,
 "presets":[{"name":"Product field guide"}]
}
{% endschema %}
