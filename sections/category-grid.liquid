<div class="section page-width" data-reveal-group>
  <div class="section-heading">
    <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="section-heading__view-all">
        {{ 'general.view_all' | t }} {{ 'general.arrow_forward' | t }}
      </a>
    {%- endif -%}
  </div>

  <div class="tile-grid{% if section.settings.path_cards %} tile-grid--path{% endif %}">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- render 'card-category',
          image: block.settings.image,
          label: block.settings.label,
          sublabel: block.settings.sublabel,
          description: block.settings.description,
          badge: block.settings.badge,
          meta_label: block.settings.meta_label,
          meta_value: block.settings.meta_value,
          mobile_image: block.settings.mobile_image,
          link: block.settings.link,
          path_style: section.settings.path_cards
        -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "checkbox", "id": "path_cards", "label": "Use expanded path card presentation", "default": false },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "text", "id": "sublabel", "label": "Collapsed supporting text" },
        { "type": "textarea", "id": "description", "label": "Expanded supporting text" },
        { "type": "text", "id": "badge", "label": "Top badge" },
        { "type": "text", "id": "meta_label", "label": "Expanded meta label" },
        { "type": "text", "id": "meta_value", "label": "Expanded meta value" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Backpacks", "sublabel": "Carry further." } },
        { "type": "tile", "settings": { "label": "Camp & Shelter", "sublabel": "Stay ready." } },
        { "type": "tile", "settings": { "label": "Tools & Equipment", "sublabel": "Built for more." } },
        { "type": "tile", "settings": { "label": "Apparel", "sublabel": "All conditions." } }
      ]
    }
  ]
}
{% endschema %}
