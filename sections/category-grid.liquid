<div class="section page-width" data-reveal-group>
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:20px">
    <h2 style="font-size:22px">{{ section.settings.heading }}</h2>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)">
        {{ 'general.view_all' | t }} &rarr;
      </a>
    {%- endif -%}
  </div>

  <div class="tile-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- render 'card-category',
          image: block.settings.image,
          label: block.settings.label,
          sublabel: block.settings.sublabel,
          link: block.settings.link
        -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Backpacks", "sublabel": "Carry further." } },
        { "type": "tile", "settings": { "label": "Camp & Shelter", "sublabel": "Stay ready." } },
        { "type": "tile", "settings": { "label": "Tools & Equipment", "sublabel": "Built for more." } },
        { "type": "tile", "settings": { "label": "Apparel", "sublabel": "All conditions." } }
      ]
    }
  ]
}
{% endschema %}
