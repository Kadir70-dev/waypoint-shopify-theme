<div class="section page-width" data-reveal-group>
  <div class="section-heading">
    <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="section-heading__view-all">
        {{ 'general.view_all' | t }} &rarr;
      </a>
    {%- endif -%}
  </div>

  <div class="tile-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- render 'card-category',
          image: block.settings.image,
          label: block.settings.label,
          sublabel: block.settings.sublabel,
          link: block.settings.link
        -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "text", "id": "sublabel", "label": "Sublabel" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Backpacks", "sublabel": "Carry further." } },
        { "type": "tile", "settings": { "label": "Camp & Shelter", "sublabel": "Stay ready." } },
        { "type": "tile", "settings": { "label": "Tools & Equipment", "sublabel": "Built for more." } },
        { "type": "tile", "settings": { "label": "Apparel", "sublabel": "All conditions." } }
      ]
    }
  ]
}
{% endschema %}
