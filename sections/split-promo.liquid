<div class="section page-width" data-reveal-group>
  <div
    style="display:grid;gap:1px;background:var(--border);grid-template-columns:1fr;{% if section.settings.image_position == 'right' %}direction:rtl{% endif %}"
    class="split-promo"
  >
    <div class="photo brand split-promo__image" data-reveal {% if section.settings.image %}style="background-image:url({{ section.settings.image | image_url: width: 1000 }})"{% endif %}></div>
    <div style="background:var(--bg);padding:36px;display:flex;flex-direction:column;justify-content:center;gap:14px;direction:ltr" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 style="font-size:26px">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div style="color:var(--muted);font-size:14px;line-height:1.6">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn-outline" style="align-self:flex-start;margin-top:6px">
          {{ section.settings.cta_label }} &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .split-promo__image { min-height: 260px; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .split-promo { grid-template-columns: 1.1fr 1fr; }
    #shopify-section-{{ section.id }} .split-promo__image { min-height: 100%; }
  }
</style>

{% schema %}
{
  "name": "Split promo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Engineered for Extremes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Details That Perform" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From alpine ridges to dense forests, every element is designed with purpose. Premium materials. Rigorously tested. No compromises.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Our Approach" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Split promo" }]
}
{% endschema %}
