{{ 'component-branch-locations.css' | asset_url | stylesheet_tag }}
{% if section.settings.maptiler_key != blank and section.blocks.size > 0 %}
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.17.0/dist/maplibre-gl.css">
{% endif %}
<script type="module" src="{{ 'branch-locations.js' | asset_url }}"></script>

<section
  class="waypoint-locations section"
  id="WaypointLocations-{{ section.id }}"
  data-waypoint-locations
  data-map-key="{{ section.settings.maptiler_key | escape }}"
  data-initial-view="{{ section.settings.initial_view | escape }}"
  data-3d-default="{{ section.settings.enable_terrain }}"
  style="--locations-map-height: {{ section.settings.map_height }}px"
  aria-labelledby="WaypointLocationsTitle-{{ section.id }}"
>
  <div class="page-width">
    <header class="waypoint-locations__heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="waypoint-locations__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="WaypointLocationsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <div class="waypoint-locations__intro rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
      <div class="waypoint-locations__heading-aside" aria-hidden="true">
        <span class="waypoint-locations__index">NETWORK / {{ section.blocks.size }}</span>
        <span class="waypoint-locations__globe">◎</span>
      </div>
    </header>

    <div class="waypoint-locations__workspace">
      <div class="waypoint-locations__directory">
        <div class="waypoint-locations__directory-top">
          <p class="waypoint-locations__directory-title">{{ section.settings.directory_heading | escape }}</p>
          <span class="waypoint-locations__count" data-locations-count>{{ section.blocks.size }} locations</span>
        </div>
        <div class="waypoint-locations__filters" data-locations-filters aria-label="Filter locations">
          <button type="button" class="waypoint-locations__filter is-active" data-location-filter="all" aria-pressed="true">All locations</button>
          <button type="button" class="waypoint-locations__filter" data-location-filter="headquarters" aria-pressed="false" hidden>HQ</button>
          <button type="button" class="waypoint-locations__filter" data-location-filter="office" aria-pressed="false" hidden>Offices</button>
          <button type="button" class="waypoint-locations__filter" data-location-filter="branch" aria-pressed="false" hidden>Branches</button>
          <button type="button" class="waypoint-locations__filter" data-location-filter="showroom" aria-pressed="false" hidden>Showrooms</button>
          <button type="button" class="waypoint-locations__filter" data-location-filter="warehouse" aria-pressed="false" hidden>Warehouses</button>
        </div>
        <div class="waypoint-locations__list" data-locations-list>
          {%- for block in section.blocks -%}
            {%- if block.type == 'branch' -%}
              <article
                class="waypoint-locations__card"
                data-location-card
                data-location-id="{{ block.id }}"
                data-location-type="{{ block.settings.location_type | escape }}"
                data-location-lat="{{ block.settings.latitude | escape }}"
                data-location-lng="{{ block.settings.longitude | escape }}"
                {{ block.shopify_attributes }}
              >
                <button type="button" class="waypoint-locations__select" data-location-select aria-pressed="false">
                  <span class="waypoint-locations__photo">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '100, 160, 320', sizes: '96px', alt: block.settings.name }}
                    {%- else -%}
                      <span class="waypoint-locations__photo-placeholder" aria-hidden="true">◈</span>
                    {%- endif -%}
                  </span>
                  <span class="waypoint-locations__card-text">
                    <span class="waypoint-locations__type">{{ block.settings.location_type | replace: '_', ' ' | capitalize | escape }}{% if block.settings.is_main %} · Main office{% endif %}</span>
                    <span class="waypoint-locations__name">{{ block.settings.name | default: 'New location' | escape }}</span>
                    {%- if block.settings.address != blank -%}
                      <span class="waypoint-locations__address">{{ block.settings.address | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.city != blank -%}
                      <span class="waypoint-locations__city">{{ block.settings.city | escape }}{% if block.settings.country != blank %}, {{ block.settings.country | escape }}{% endif %}</span>
                    {%- endif -%}
                  </span>
                  <span class="waypoint-locations__card-arrow" aria-hidden="true">↗</span>
                </button>
                <div class="waypoint-locations__card-extra">
                  {%- if block.settings.hours != blank -%}
                    <span class="waypoint-locations__hours">{{ block.settings.hours | escape }}</span>
                  {%- endif -%}
                  <span class="waypoint-locations__card-links">
                    {%- if block.settings.phone != blank -%}
                      <a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">Call</a>
                    {%- endif -%}
                    {%- if block.settings.address != blank or block.settings.latitude != blank -%}
                      <a
                        data-location-directions
                        {% if block.settings.address != blank %}href="https://www.google.com/maps/search/?api=1&query={{ block.settings.address | url_encode }}"{% else %}hidden{% endif %}
                        target="_blank"
                        rel="noopener noreferrer"
                      >Directions ↗</a>
                    {%- endif -%}
                  </span>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.blocks.size == 0 -%}
            <div class="waypoint-locations__no-branches">
              <span aria-hidden="true">◎</span>
              <strong>Locations will appear here</strong>
              <p>Add real offices or branches as blocks in the Shopify theme editor. Nothing is pinned until coordinates are provided.</p>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="waypoint-locations__map-panel">
        <div class="waypoint-locations__map-top">
          <div class="waypoint-locations__map-label">
            <span class="waypoint-locations__map-pulse" aria-hidden="true"></span>
            <span>Location explorer</span>
          </div>
          <div class="waypoint-locations__map-controls" data-locations-controls hidden>
            <button type="button" class="waypoint-locations__control is-active" data-map-style="satellite" aria-pressed="true">Satellite</button>
            <button type="button" class="waypoint-locations__control" data-map-style="streets" aria-pressed="false">Streets</button>
            <button type="button" class="waypoint-locations__control" data-map-3d aria-pressed="false">3D view</button>
            <button type="button" class="waypoint-locations__control" data-map-fit aria-label="Show all branch locations">All pins</button>
          </div>
        </div>
        <div class="waypoint-locations__map-shell">
          <div class="waypoint-locations__map" data-location-map role="region" aria-label="Interactive branch map"></div>
          <div class="waypoint-locations__map-empty" data-map-empty>
            <span class="waypoint-locations__map-orbit" aria-hidden="true"><span>◎</span></span>
            <strong>Every location, one beautiful view.</strong>
            <p data-location-status>
              {% if section.settings.maptiler_key == blank %}
                Add a domain-restricted MapTiler key and confirmed branch coordinates to activate satellite and 3D terrain.
              {% else %}
                Add confirmed latitude and longitude for at least one branch to activate the map.
              {% endif %}
            </p>
          </div>
        </div>
        <div class="waypoint-locations__map-footer">
          <span>Satellite imagery + 3D terrain when configured</span>
          <span>Coordinates controlled in Shopify</span>
        </div>
      </div>
    </div>
    {%- if request.design_mode -%}
      <p class="waypoint-locations__editor-note">Theme editor: add one block per real branch; enter its exact latitude and longitude (decimal degrees, e.g. -90 to 90 / -180 to 180). Add a public MapTiler API key restricted to your domain. Map imagery is provided by MapTiler and may not be current to the day; the 3D toggle uses terrain elevation, not photorealistic 3D buildings. Never enter invented branches.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Branch Locations",
  "tag": "section",
  "class": "section-company-locations",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR NETWORK"},
    {"type":"text","id":"heading","label":"Section heading","default":"Our Locations"},
    {"type":"richtext","id":"description","label":"Introduction","default":"<p>Explore the places where you can connect with our team.</p>"},
    {"type":"text","id":"directory_heading","label":"Directory label","default":"Find a location"},
    {"type":"text","id":"maptiler_key","label":"MapTiler public API key","info":"Get a public browser key from MapTiler, restrict allowed origins to your storefront domain, and enter it here. Required for satellite/3D. Never use a secret server key."},
    {"type":"select","id":"initial_view","label":"Initial map layer","default":"satellite","options":[{"value":"satellite","label":"Satellite with labels"},{"value":"streets","label":"Streets"}]},
    {"type":"checkbox","id":"enable_terrain","label":"Start with tilted 3D terrain","default":true},
    {"type":"range","id":"map_height","label":"Desktop map height","min":450,"max":750,"step":25,"unit":"px","default":650}
  ],
  "blocks": [
    {"type":"branch","name":"Branch / office","settings":[
      {"type":"text","id":"name","label":"Location name","default":"Branch name"},
      {"type":"select","id":"location_type","label":"Location type","default":"branch","options":[{"value":"headquarters","label":"Headquarters"},{"value":"office","label":"Office"},{"value":"branch","label":"Branch"},{"value":"showroom","label":"Showroom"},{"value":"warehouse","label":"Warehouse"}]},
      {"type":"checkbox","id":"is_main","label":"Mark main office","default":false},
      {"type":"text","id":"address","label":"Verified street address"},
      {"type":"text","id":"city","label":"City"},
      {"type":"text","id":"country","label":"Country"},
      {"type":"text","id":"latitude","label":"Latitude (decimal, -90 to 90)","info":"Copy an exact pin latitude from a trusted map. No guesses."},
      {"type":"text","id":"longitude","label":"Longitude (decimal, -180 to 180)","info":"Copy an exact pin longitude from a trusted map. No guesses."},
      {"type":"text","id":"phone","label":"Branch phone (optional)"},
      {"type":"text","id":"hours","label":"Displayed hours (optional)","info":"Write published hours only; not a real-time open/closed indicator."},
      {"type":"image_picker","id":"image","label":"Branch photo (optional)"}
    ]}
  ],
  "max_blocks": 30,
  "presets": [{"name":"Branch Locations"}]
}
{% endschema %}
