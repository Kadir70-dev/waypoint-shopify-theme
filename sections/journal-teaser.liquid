{%- comment -%}
  Uses the shared snippets/card-article.liquid (Milestone 6) so the
  Journal index (main-blog.liquid) and this homepage teaser stay in sync
  — this section used to inline its own article-card markup; see git
  history for that version.
{%- endcomment -%}

{%- liquid
  assign blog = section.settings.blog
-%}
{%- if blog != blank -%}
  <div class="section page-width" data-reveal-group>
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:20px">
      <div>
        <h2 style="font-size:22px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p style="color:var(--muted);font-size:13px;margin-top:6px">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <a href="{{ blog.url }}" style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)">
        {{ 'general.view_all' | t }} &rarr;
      </a>
    </div>

    <div class="acard-grid">
      {%- for article in blog.articles limit: section.settings.articles_to_show -%}
        {%- render 'card-article', article: article -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Journal teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Stories" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Insights, field notes and real experiences from our community." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_to_show", "label": "Articles to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Journal teaser" }],
  "enabled_on": {
    "templates": ["index", "blog", "article", "page"]
  }
}
{% endschema %}
