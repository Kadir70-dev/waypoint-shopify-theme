{{ 'component-rotating-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rotating-gallery.js' | asset_url }}" defer></script>
{%- assign gallery_product = section.settings.product | default: product -%}
<waypoint-gallery class="waypoint-gallery page-width" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" aria-labelledby="GalleryTitle-{{ section.id }}">
  <div class="section-header"><h2 id="GalleryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div></div>
  <div class="waypoint-gallery__track" id="GalleryTrack-{{ section.id }}" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <figure class="waypoint-gallery__slide" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600', sizes: '(min-width: 990px) 70vw, 90vw' }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for gallery_image in gallery_product.images -%}
        <figure class="waypoint-gallery__slide">{{ gallery_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600', sizes: '(min-width: 990px) 70vw, 90vw' }}</figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="waypoint-gallery__controls" hidden>
    <button type="button" class="btn" data-prev aria-controls="GalleryTrack-{{ section.id }}">{{ 'products.gallery_previous' | t }}</button>
    <span data-count aria-live="off"></span>
    <button type="button" class="btn" data-next aria-controls="GalleryTrack-{{ section.id }}">{{ 'products.gallery_next' | t }}</button>
    <button type="button" class="btn" data-pause hidden>{{ section.settings.pause_label | escape }}</button>
  </div>
  {%- if request.design_mode -%}<p>Select a product to use its images, or add image blocks. Use photographs of the same item for product views. This is a rotating slideshow, not a 360° product model.</p>{%- endif -%}
</waypoint-gallery>
{% schema %}
{
 "name":"Rotating image gallery",
 "settings":[
  {"type":"text","id":"heading","label":"Heading","default":"A closer look"},
  {"type":"richtext","id":"text","label":"Introduction"},
  {"type":"product","id":"product","label":"Product images","info":"Leave empty on a product page to use the current product. Image blocks take priority."},
  {"type":"checkbox","id":"autoplay","label":"Rotate automatically","default":false},
  {"type":"range","id":"interval","label":"Seconds between images","min":5,"max":12,"step":1,"default":7},
  {"type":"text","id":"pause_label","label":"Stop rotation label","default":"Stop rotation"}
 ],
 "blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"}]}],
 "max_blocks":12,
 "presets":[{"name":"Rotating image gallery"}]
}
{% endschema %}
