{%- comment -%}
  Waypoint cart drawer (Milestone 5).

  A genuine section — not a snippet — so it's independently fetchable via
  the Section Rendering API (?section_id=cart-drawer) after any cart
  mutation. Intentionally never added to any JSON template's section
  order, only ever reached by its handle — the same intentional pattern
  sections/predictive-search.liquid already established in Milestone 1.
  Included inline via the static {% section %} tag from
  sections/header.liquid, so it always exists in the DOM regardless of
  settings.cart_type (see cart.js: every successful add-to-cart opens it
  as a confirmation, even in "page" cart mode — the header cart icon
  itself only opens it as the primary click target when cart_type is
  "drawer").
{%- endcomment -%}
<script type="application/json" data-cart-routes>
  { "cart_url": {{ routes.cart_url | json }} }
</script>
<div id="CartDrawer" class="cart-drawer" data-overlay data-overlay-backdrop hidden role="dialog" aria-modal="true" aria-label="{{ 'accessibility.cart_dialog' | t }}">
  <div class="cart-drawer__panel">
   <div
     class="visually-hidden"
     aria-live="polite"
     data-cart-status
     data-status-added="{{ 'cart.status_added' | t }}"
     data-status-removed="{{ 'cart.status_removed' | t }}"
     data-status-updated="{{ 'cart.status_updated' | t }}"
     data-status-cleared="{{ 'cart.status_cleared' | t }}"
     data-status-count-one="{{ 'cart.status_count_one' | t }}"
     data-status-count-other="{{ 'cart.status_count_other' | t }}"
   ></div>
   <div class="cart-drawer__error" data-cart-error hidden role="alert"></div>
   {%- comment -%}
     Everything below is swapped wholesale by cart.js on refresh (one id,
     one innerHTML replace) rather than several fine-grained swaps — the
     simplest correct way to also handle the empty <-> non-empty layout
     change, since the two states aren't just a few different values but
     structurally different markup (no <form>/summary at all when empty).
     Same "swap by container id" technique the PDP buy box already uses.
   {%- endcomment -%}
   <div id="CartDrawerContent">
    <div class="cart-drawer__top">
      <h2 class="cart-drawer__heading">
        {{ 'cart.heading' | t }}
        {%- if cart.item_count > 0 -%}
          <span class="cart-drawer__count" data-cart-drawer-count>
            {%- if cart.item_count == 1 -%}
              ({{ 'cart.item_count_one' | t: count: cart.item_count }})
            {%- else -%}
              ({{ 'cart.item_count_other' | t: count: cart.item_count }})
            {%- endif -%}
          </span>
        {%- endif -%}
      </h2>
      <button class="icon-btn" type="button" data-overlay-close aria-label="{{ 'accessibility.close' | t }}" data-overlay-autofocus>
        {%- render 'icon-close' -%}
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      {%- render 'promo-strip', inline: true -%}
      {%- render 'free-shipping-bar' -%}

      {%- assign cross_sell_collection = settings.cart_cross_sell_collection -%}
      {%- if settings.show_cart_cross_sell and cross_sell_collection != blank and cross_sell_collection.products_count > 0 -%}
        <section class="cart-cross-sell" aria-labelledby="CartCrossSellHeading">
          <h3 id="CartCrossSellHeading">{{ settings.cart_cross_sell_heading | default: 'You May Also Like' }}</h3>
          <div class="cart-cross-sell__items">
            {%- for cross_product in cross_sell_collection.products limit: settings.cart_cross_sell_products -%}
              {%- assign cross_variant = cross_product.selected_or_first_available_variant -%}
              <article class="cart-cross-sell__item">
                <a href="{{ cross_product.url }}" class="cart-cross-sell__media">
                  {%- if cross_product.featured_image -%}{{ cross_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '60px', alt: cross_product.title }}{%- endif -%}
                </a>
                <div class="cart-cross-sell__body">
                  <a href="{{ cross_product.url }}" class="cart-cross-sell__title">{{ cross_product.title }}</a>
                  {%- render 'price', product: cross_product, variant: cross_variant -%}
                </div>
                {%- if cross_variant.available and cross_product.has_only_default_variant -%}
                  <form method="post" action="{{ routes.cart_add_url }}" data-cart-add-form>
                    <input type="hidden" name="id" value="{{ cross_variant.id }}">
                    <button type="submit" class="icon-btn" aria-label="{{ 'products.quick_add' | t }}: {{ cross_product.title }}">{%- render 'icon-plus' -%}</button>
                  </form>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- form 'cart', cart, id: 'CartDrawerForm', class: 'cart-drawer__form', data-cart-form: true -%}
        <div class="cart-drawer__items" data-cart-items>
          {%- for item in cart.items -%}
            {%- render 'cart-line-item', item: item -%}
          {%- endfor -%}
        </div>

        <div class="cart-drawer__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-drawer__subtotal">
              <span>{{ discount.title }}</span>
              <span>&minus;{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-drawer__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
          {%- if cart.taxes_included -%}<p class="cart-drawer__shipping-note">{{ 'cart.tax_included' | t }}</p>{%- endif -%}
          <p class="cart-drawer__shipping-note">{{ 'cart.shipping_at_checkout' | t }}</p>
          <a href="{{ routes.cart_url }}" class="btn btn-outline btn-block">{{ 'cart.view_cart' | t }}</a>
          <button type="submit" name="checkout" class="btn btn-primary btn-block" style="margin-top:10px">
            {{ 'cart.checkout' | t }} {{ 'general.arrow_forward' | t }}
          </button>
          {{ form | payment_button }}
        </div>
      {%- endform -%}
    {%- else -%}
      <div class="cart-drawer__empty">
        <svg class="empty-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.3">
          <path d="M14 20h36l-3 26a4 4 0 0 1-4 3.6H21a4 4 0 0 1-4-3.6L14 20Z"/>
          <path d="M23 20v-4a9 9 0 0 1 18 0v4"/>
        </svg>
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline" data-overlay-close>{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}
   </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer"
}
{% endschema %}
