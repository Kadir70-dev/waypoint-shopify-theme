<div class="section page-width" data-carousel>
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:20px">
    <div>
      <h2 style="font-size:20px">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p style="color:var(--muted);font-size:13px;margin-top:6px">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="carousel__nav">
        <button type="button" data-carousel-prev aria-label="{{ 'sections.carousel.previous' | t }}">{%- render 'icon-chevron-left' -%}</button>
        <button type="button" data-carousel-next aria-label="{{ 'sections.carousel.next' | t }}">{%- render 'icon-chevron-right' -%}</button>
      </div>
    {%- endif -%}
  </div>

  <div class="carousel__track" data-carousel-track>
    {%- for block in section.blocks -%}
      <blockquote
        data-carousel-item
        style="width:min(88vw, 520px);border:1px solid var(--border);padding:28px;margin:0"
        {{ block.shopify_attributes }}
      >
        <p class="editorial-quote" style="font-size:18px">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <footer style="margin-top:16px;font-size:12px;color:var(--muted)">
          &mdash; {{ block.settings.name }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}
        </footer>
      </blockquote>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonial carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by Explorers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real people. Real places." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Add a customer quote here to highlight what people love about your products." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "location", "label": "Location / role", "default": "Customer location" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial carousel",
      "blocks": [{ "type": "testimonial" }]
    }
  ]
}
{% endschema %}
