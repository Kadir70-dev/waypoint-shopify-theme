{{ 'component-demo-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign campaign_product = section.settings.product
  if campaign_product == blank and product != blank
    assign campaign_product = product
  endif
  assign campaign_image = section.settings.image | default: campaign_product.featured_image
-%}
<section class="waypoint-page page-width" aria-labelledby="PreorderTitle-{{ section.id }}">
  <div class="waypoint-preorder">
    <div class="waypoint-preorder__media">
      {%- if campaign_image != blank -%}
        {{ campaign_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="waypoint-preorder__details">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.primary_heading -%}<h1 id="PreorderTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>{%- else -%}<h2 id="PreorderTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if campaign_product != blank -%}
        {%- assign active_purchase_options = false -%}
        {%- if campaign_product.selling_plan_groups.size > 0 -%}
          {%- assign active_purchase_options = true -%}
        {%- endif -%}
        <div class="waypoint-preorder__status" role="status">
          <span class="waypoint-preorder__status-dot" aria-hidden="true"></span>
          {%- if active_purchase_options -%}
            {{ 'products.preorder.configured' | t }}
          {%- else -%}
            Preview only · Pre-orders not active
          {%- endif -%}
        </div>
        <h2>{{ campaign_product.title | escape }}</h2>
        {%- unless active_purchase_options -%}
          <p class="waypoint-preorder__notice">{{ 'products.preorder.notice' | t }}</p>
        {%- endunless -%}
      {%- endif -%}
      {%- if section.settings.dispatch_text != blank or section.settings.terms != blank -%}
        <div class="waypoint-preorder__terms">
          {%- if section.settings.dispatch_text != blank -%}<p>{{ section.settings.dispatch_text | escape }}</p>{%- endif -%}
          {%- if section.settings.terms != blank -%}<div class="rte">{{ section.settings.terms }}</div>{%- endif -%}
          {%- if section.settings.policy_page != blank -%}<a href="{{ section.settings.policy_page.url }}">{{ section.settings.policy_page.title | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if campaign_product != blank and request.page_type != 'product' and section.settings.button_label != blank -%}
        <a class="btn btn-primary" href="{{ campaign_product.url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      <div class="waypoint-preorder__apps">
        {%- for block in section.blocks -%}{%- render block -%}{%- endfor -%}
      </div>
      {%- if request.design_mode -%}<p class="waypoint-page__empty">Campaign content only. Configure a pre-order app and its product-page purchase options before accepting pre-orders. Set an accurate dispatch estimate and payment/cancellation terms. This section does not change inventory, charge customers or create selling plans.</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Pre-order campaign",
  "settings":[
    {"type":"checkbox","id":"primary_heading","label":"Use as the page title (H1)","default":false},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"On the horizon"},
    {"type":"text","id":"heading","label":"Heading","default":"Your next adventure starts here"},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>Discover the upcoming collection and explore the details before its arrival.</p>"},
    {"type":"product","id":"product","label":"Featured product","info":"On a product page, leave empty to use that product."},
    {"type":"image_picker","id":"image","label":"Campaign image"},
    {"type":"text","id":"dispatch_text","label":"Expected dispatch","info":"Enter a real estimate, including the year. Update it if plans change."},
    {"type":"richtext","id":"terms","label":"Payment and cancellation terms"},
    {"type":"page","id":"policy_page","label":"Full terms page"},
    {"type":"text","id":"button_label","label":"Product link label","default":"View product details"}
  ],
  "blocks":[{"type":"@app"}],
  "presets":[{"name":"Pre-order campaign"}]
}
{% endschema %}
