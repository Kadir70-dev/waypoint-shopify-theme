<section
  id="VideoPageBreaker-{{ section.id }}"
  class="video-page-breaker video-page-breaker--{{ section.settings.content_alignment }}"
  style="--video-desktop-height:{{ section.settings.desktop_height }}px;--video-mobile-height:{{ section.settings.mobile_height }}px;--video-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--video-text-color:{{ section.settings.text_color }}"
>
  <div class="video-page-breaker__media">
    <picture class="video-page-breaker__poster">
      {%- if section.settings.mobile_poster != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_poster | image_url: width: 1200 }}">
      {%- endif -%}
      {%- if section.settings.desktop_poster != blank -%}
        {{ section.settings.desktop_poster | image_url: width: 2200 | image_tag: loading: 'lazy', sizes: '100vw', alt: '', class: 'video-page-breaker__poster-image' }}
      {%- else -%}
        <span class="video-page-breaker__poster-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </picture>
    {%- if section.settings.video != blank -%}
      <video class="video-page-breaker__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- endif -%}
    <div class="video-page-breaker__overlay" aria-hidden="true"></div>
  </div>

  <div class="video-page-breaker__content" data-reveal-group>
    {%- if section.settings.eyebrow != blank -%}
      <p class="video-page-breaker__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="video-page-breaker__heading" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="video-page-breaker__text" data-reveal>{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a class="video-page-breaker__cta btn btn-primary" data-reveal href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('VideoPageBreaker-{{ section.id }}');
    var video = section && section.querySelector('.video-page-breaker__video');
    if (!video) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }
    var ready = function () { section.classList.add('video-page-breaker--ready'); };
    video.addEventListener('canplay', ready, { once: true });
    if (video.readyState >= 3) ready();
  }());
</script>

{% stylesheet %}
.video-page-breaker { position: relative; min-height: var(--video-mobile-height); overflow: hidden; color: var(--video-text-color); background: var(--surface-3); }
.video-page-breaker__media, .video-page-breaker__poster, .video-page-breaker__video, .video-page-breaker__overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
.video-page-breaker__poster { z-index: 0; }
.video-page-breaker__poster-image, .video-page-breaker__poster-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
.video-page-breaker__poster-placeholder { background: var(--surface-3); }
.video-page-breaker__video { z-index: 1; object-fit: cover; opacity: 0; transition: opacity var(--dur-base) var(--ease-out-slow); }
.video-page-breaker--ready .video-page-breaker__poster { opacity: 0; }
.video-page-breaker--ready .video-page-breaker__video { opacity: 1; }
.video-page-breaker__overlay { z-index: 2; background: linear-gradient(180deg, rgb(0 0 0 / calc(var(--video-overlay-opacity) * .7)), rgb(0 0 0 / var(--video-overlay-opacity))); pointer-events: none; }
.video-page-breaker__content { position: relative; z-index: 3; min-height: var(--video-mobile-height); max-width: 760px; margin-inline: auto; padding: 48px 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.video-page-breaker__eyebrow { margin: 0 0 16px; color: currentColor; font-family: var(--font-display); font-size: 11px; letter-spacing: var(--tracking-label); text-transform: uppercase; }
.video-page-breaker__heading { max-width: 760px; color: currentColor; font-size: clamp(36px, 7vw, 84px); line-height: .98; white-space: pre-line; }
.video-page-breaker__text { max-width: 480px; margin-top: 20px; color: currentColor; font-size: 15px; line-height: var(--leading-relaxed); }
.video-page-breaker__cta { margin-top: 28px; }
.video-page-breaker--start .video-page-breaker__content { align-items: flex-start; text-align: start; }
.video-page-breaker--end .video-page-breaker__content { align-items: flex-end; text-align: end; }
@media (min-width: 750px) {
  .video-page-breaker, .video-page-breaker__content { min-height: var(--video-desktop-height); }
  .video-page-breaker__content { padding: 72px 40px; }
}
@media (prefers-reduced-motion: reduce) { .video-page-breaker__video { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Video page breaker",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "desktop_poster", "label": "Desktop poster" },
    { "type": "image_picker", "id": "mobile_poster", "label": "Mobile poster" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BUILT FOR WHAT'S OUT THERE" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "GO BEYOND THE\nEXPECTED" },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Equipment and essentials made for the places that demand more." },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 500, "max": 800, "step": 10, "default": 640, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 400, "max": 650, "step": 10, "default": 500, "unit": "px" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "default": 40, "unit": "%" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "start", "label": "Start" },
      { "value": "end", "label": "End" }
    ] },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Video page breaker" }
  ]
}
{% endschema %}
