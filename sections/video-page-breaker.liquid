<section
  id="VideoPageBreaker-{{ section.id }}"
  class="video-page-breaker"
>
  <video
    class="video-page-breaker__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="{{ 'breakervideo.mp4' | asset_url }}" type="video/mp4">
  </video>

  <div class="video-page-breaker__readability" aria-hidden="true"></div>
  <div class="video-page-breaker__content">
    <p class="video-page-breaker__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="video-page-breaker__heading">{{ section.settings.heading }}</h2>
    <p class="video-page-breaker__text">{{ section.settings.supporting_text }}</p>
    <a class="video-page-breaker__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% stylesheet %}
.video-page-breaker { position: relative; width: 100%; overflow: hidden; }
.video-page-breaker__video { display: block; width: 100%; height: auto; }
.video-page-breaker__readability { position: absolute; inset: 0 auto 0 0; z-index: 1; width: min(58%, 760px); pointer-events: none; background: linear-gradient(90deg, rgba(8, 10, 8, 0.38) 0%, rgba(8, 10, 8, 0.16) 58%, transparent 100%); }
.video-page-breaker__content { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: min(42rem, 85%); margin-left: 7.5vw; color: #fff; text-align: left; }
.video-page-breaker__eyebrow { margin: 0 0 1.25rem; font-size: clamp(0.65rem, 0.75vw, 0.8rem); font-weight: 600; letter-spacing: 0.22em; line-height: 1.2; text-transform: uppercase; text-shadow: 0 1px 18px rgba(0, 0, 0, 0.22); }
.video-page-breaker__heading { max-width: 11ch; margin: 0; font-size: clamp(3.5rem, 7.5vw, 7.5rem); font-weight: 700; letter-spacing: -0.055em; line-height: 0.9; text-wrap: balance; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.2); }
.video-page-breaker__text { max-width: 28rem; margin: 1.75rem 0 0; font-size: clamp(0.95rem, 1.25vw, 1.2rem); line-height: 1.5; text-shadow: 0 1px 18px rgba(0, 0, 0, 0.25); }
.video-page-breaker__cta { display: inline-flex; align-items: center; margin-top: 2rem; padding: 0.8rem 0; border-bottom: 1px solid currentColor; color: inherit; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; line-height: 1; text-decoration: none; text-transform: uppercase; transition: opacity 180ms ease, border-color 180ms ease; }
.video-page-breaker__cta:hover { opacity: 0.72; }
.video-page-breaker__cta:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
@media (max-width: 749px) { .video-page-breaker__readability { width: 100%; background: linear-gradient(90deg, rgba(8, 10, 8, 0.32) 0%, rgba(8, 10, 8, 0.08) 72%, transparent 100%); } .video-page-breaker__content { width: auto; margin: 0; padding: 2rem 1.5rem; } .video-page-breaker__eyebrow { margin-bottom: 0.9rem; font-size: 0.62rem; letter-spacing: 0.18em; } .video-page-breaker__heading { max-width: 8ch; font-size: clamp(3rem, 15vw, 4.75rem); line-height: 0.92; } .video-page-breaker__text { max-width: 19rem; margin-top: 1.25rem; font-size: 0.95rem; } .video-page-breaker__cta { margin-top: 1.5rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Video page breaker",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BUILT FOR THE OUTDOORS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GO BEYOND." },
    { "type": "textarea", "id": "supporting_text", "label": "Supporting text", "default": "Gear made for wherever the path takes you." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "EXPLORE THE COLLECTION" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [
    { "name": "Video page breaker" }
  ]
}
{% endschema %}
