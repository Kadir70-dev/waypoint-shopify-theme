<section
  id="VideoPageBreaker-{{ section.id }}"
  class="video-page-breaker"
>
  <video
    class="video-page-breaker__video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
  >
    {%- if section.settings.video != blank -%}
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    {%- else -%}
      <source src="{{ 'breakervideo.mp4' | asset_url }}" type="video/mp4">
    {%- endif -%}
  </video>
</section>

{% stylesheet %}
.video-page-breaker { width: 100%; overflow: hidden; }
.video-page-breaker__video { display: block; width: 100%; height: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Video page breaker",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" }
  ],
  "presets": [
    { "name": "Video page breaker" }
  ]
}
{% endschema %}
