{%- comment -%}
  Native Shopify product recommendations (Milestone 4).

  Same Section Rendering API pattern as the PDP buy box and predictive
  search: recommendations.performed is only ever true when this section
  is fetched from the dedicated /recommendations/products endpoint, so
  the <product-recommendations> element below always renders (as an
  anchor for that fetch) but its content is empty on the product page's
  normal load. product-recommendations.js fetches the endpoint with the
  real product/section params and swaps the response in. Shopify's own
  recommendation engine supplies the products — nothing here is
  hardcoded, and there is no client-side fallback product list.

  Reuses card-product + .product-grid unmodified, per the "cross-sell
  rows in later milestones" note already in component-product-card.css.
{%- endcomment -%}
<product-recommendations
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section page-width" data-reveal-group>
      <h2 style="font-size:22px;margin-bottom:20px">{{ section.settings.heading }}</h2>
      <div class="product-grid" data-context="featured">
        {%- for product in recommendations.products -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 5 },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related (similar products)" },
        { "value": "complementary", "label": "Complementary (goes well with)" }
      ],
      "default": "related"
    }
  ]
}
{% endschema %}
