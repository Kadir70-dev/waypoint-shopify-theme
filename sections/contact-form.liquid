{%- comment -%}
  Native Shopify contact form (Milestone 9 — required for Theme Store
  templates/page.contact.json, also addable to any page). Submits via
  Shopify's built-in `contact` form type — no backend/app required,
  delivered to the store's customer email. Styled with inline styles
  (not component-account.css) so this section works even when placed on
  a page template that doesn't load that stylesheet (see layout/theme
  .liquid's per-template CSS gating, Milestone 8).
{%- endcomment -%}
<div class="section page-width contact-form">
  {%- if section.settings.heading != blank -%}
    <h2 class="contact-form__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- form 'contact', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">{{ 'contact.form.post_success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-message" role="alert">
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="contact-form__fields">
      <div class="field">
        <label for="ContactFormName" class="eyebrow">{{ 'contact.form.name_label' | t }}</label>
        <input
          type="text"
          id="ContactFormName"
          class="field__input"
          name="contact[name]"
          value="{{ form.name }}"
        >
      </div>
      <div class="field">
        <label for="ContactFormEmail" class="eyebrow">{{ 'contact.form.email_label' | t }}</label>
        <input
          type="email"
          id="ContactFormEmail"
          class="field__input"
          name="contact[email]"
          value="{{ form.email | default: customer.email }}"
          autocomplete="email"
          required
        >
      </div>
      <div class="field">
        <label for="ContactFormPhone" class="eyebrow">{{ 'contact.form.phone_label' | t }}</label>
        <input
          type="tel"
          id="ContactFormPhone"
          class="field__input"
          name="contact[phone]"
          value="{{ form.phone }}"
          autocomplete="tel"
        >
      </div>
      <div class="field">
        <label for="ContactFormMessage" class="eyebrow">{{ 'contact.form.message_label' | t }}</label>
        <textarea
          id="ContactFormMessage"
          class="field__input"
          name="contact[body]"
          rows="6"
          required
        >{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn-primary contact-form__submit">
        {{ 'contact.form.submit' | t }}
      </button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
