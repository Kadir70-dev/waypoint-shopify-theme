{%- comment -%}
  Native Shopify contact form (Milestone 9 — required for Theme Store
  templates/page.contact.json, also addable to any page). Submits via
  Shopify's built-in `contact` form type — no backend/app required,
  delivered to the store's customer email. Styled with inline styles
  (not component-account.css) so this section works even when placed on
  a page template that doesn't load that stylesheet (see layout/theme
  .liquid's per-template CSS gating, Milestone 8).
{%- endcomment -%}
<div class="section page-width" style="max-width:560px">
  {%- if section.settings.heading != blank -%}
    <h2 style="font-size:22px;margin-bottom:20px">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- form 'contact', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <p role="status" style="margin-bottom:16px">{{ 'contact.form.post_success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div role="alert" style="margin-bottom:16px">
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div style="display:flex;flex-direction:column;gap:16px">
      <div style="display:flex;flex-direction:column;gap:6px;text-align:left">
        <label for="ContactFormName" class="eyebrow">{{ 'contact.form.name_label' | t }}</label>
        <input
          type="text"
          id="ContactFormName"
          name="contact[name]"
          value="{{ form.name }}"
          style="background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:12px 14px;font-family:var(--font-body);font-size:14px;"
        >
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;text-align:left">
        <label for="ContactFormEmail" class="eyebrow">{{ 'contact.form.email_label' | t }}</label>
        <input
          type="email"
          id="ContactFormEmail"
          name="contact[email]"
          value="{{ form.email | default: customer.email }}"
          autocomplete="email"
          required
          style="background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:12px 14px;font-family:var(--font-body);font-size:14px;"
        >
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;text-align:left">
        <label for="ContactFormPhone" class="eyebrow">{{ 'contact.form.phone_label' | t }}</label>
        <input
          type="tel"
          id="ContactFormPhone"
          name="contact[phone]"
          value="{{ form.phone }}"
          autocomplete="tel"
          style="background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:12px 14px;font-family:var(--font-body);font-size:14px;"
        >
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;text-align:left">
        <label for="ContactFormMessage" class="eyebrow">{{ 'contact.form.message_label' | t }}</label>
        <textarea
          id="ContactFormMessage"
          name="contact[body]"
          rows="6"
          required
          style="background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:12px 14px;font-family:var(--font-body);font-size:14px;resize:vertical;"
        >{{ form.body }}</textarea>
      </div>
      <button
        type="submit"
        style="font-family:var(--font-display);font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px 22px;background:var(--cta-bg);color:var(--cta-text);border:0;cursor:pointer;align-self:flex-start;"
      >
        {{ 'contact.form.submit' | t }}
      </button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
