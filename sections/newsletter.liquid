<div class="section page-width newsletter-split" data-reveal>
  <div class="newsletter-split__text">
    <h2 style="font-size:20px">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p style="color:var(--muted);font-size:14px;max-width:40ch">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>

  <div class="newsletter-split__form">
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-block__row">
          <label for="NewsletterSectionEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.email_label' | t }}</label>
          <input
            type="email"
            id="NewsletterSectionEmail-{{ section.id }}"
            name="contact[email]"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            required
          >
          <button type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
        <label class="newsletter-block__consent">
          <input type="checkbox" name="contact[accepts_marketing]" value="1" required style="margin-top:2px">
          {{ 'newsletter.consent' | t }}
        </label>
        {%- if form.errors -%}
          <p role="alert">{{ form.errors.messages['contact[email]'] }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .newsletter-split {
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .newsletter-split__text p { margin-top: 8px; }
  #shopify-section-{{ section.id }} .newsletter-split__form { max-width: 420px; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .newsletter-split { flex-direction: row; align-items: center; justify-content: space-between; gap: 40px; }
    #shopify-section-{{ section.id }} .newsletter-split__form { width: 380px; flex-shrink: 0; }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the Wild" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join for exclusive releases, field notes and 10% off your first order." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
