{%- liquid
  assign product = section.settings.product
  assign featured_image = section.settings.image_override | default: product.featured_image
-%}
{%- if product != blank -%}
  <div class="section page-width" data-reveal-group>
    <div style="display:grid;gap:1px;background:var(--border)" class="featured-product">
      <div class="featured-product__image" data-reveal>
        {%- if featured_image != blank -%}
          {{ featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- elsif request.design_mode -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div style="background:var(--bg);padding:36px;display:flex;flex-direction:column;gap:12px;justify-content:center" data-reveal>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 style="font-size:24px">{{ product.title }}</h2>
        {%- assign ob_check = product.tags | join: ',' -%}
        {%- if ob_check contains 'offer-' -%}
          <div style="margin-top:2px">{%- render 'offer-badge', product: product -%}</div>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p style="color:var(--muted);font-size:14px">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- render 'price', product: product -%}
        <a href="{{ product.url }}" class="btn btn-primary" style="align-self:flex-start;margin-top:8px">
          {{ section.settings.cta_label }} {{ 'general.arrow_forward' | t }}
        </a>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {%- render block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} .featured-product__image { min-height: 260px; background: var(--surface-2); display: grid; place-items: center; }
    #shopify-section-{{ section.id }} .featured-product__image img,
    #shopify-section-{{ section.id }} .featured-product__image svg { width: 100%; height: auto; max-height: 650px; object-fit: contain; display: block; }
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} .featured-product { grid-template-columns: 1fr 1.1fr; }
      #shopify-section-{{ section.id }} .featured-product__image { min-height: 100%; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image_override", "label": "Image override", "info": "Uses the product's featured image if left blank." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Gear" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View Product" }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
