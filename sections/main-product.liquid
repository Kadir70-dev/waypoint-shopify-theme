{%- comment -%}
  Core PDP: breadcrumb + gallery + buy box + variant picker + product
  info blocks (specifications / accordions) + sticky mobile ATC bar.
  3D/AR media and the quick-view modal remain separate, later slices of
  Milestone 4 (settings.enable_3d_ar exists but is intentionally unused
  here — see Milestone 4 report, KNOWN DIFFERENCES) — this section
  handles image, native video and external (YouTube/Vimeo) media, and
  falls back to the preview image for any other media type so the
  gallery never breaks on a product with a 3D model attached.

  Variant swap uses the Section Rendering API (?variant=<id>&section_id=
  main-product) so price/availability/SKU are always server-rendered —
  same pattern already proven for predictive search, and matches the
  architecture's own "Section Rendering API fallback exercised" note.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign specs = product.metafields.specs
-%}

{%- comment -%}
  Product structured data (Milestone 8 SEO). Only real Shopify data —
  no fabricated ratings/reviews/price/availability. aggregateRating is
  included only when the same reviews metafield namespace snippets/
  star-rating.liquid reads is actually populated on this product.
{%- endcomment -%}
{%- liquid
  assign ld_rating = product.metafields.reviews.rating.value
  assign ld_rating_count = product.metafields.reviews.rating_count.value
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if product.featured_image %}
  "image": [{{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}],
  {%- endif %}
  {%- if current_variant.sku != blank %}
  "sku": {{ current_variant.sku | json }},
  {%- endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | round: 2 | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
  }{%- if ld_rating != blank %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ ld_rating.rating | json }},
    "reviewCount": {{ ld_rating_count | default: 0 | json }}
  }{%- endif %}
}
</script>

<div class="section page-width">
  {%- render 'breadcrumb', product: product -%}

  <div class="product-layout">
    <div class="product-gallery" data-product-gallery>
      {%- if product.media.size > 0 -%}
        <div class="product-gallery__main" data-gallery-scroller tabindex="0" role="group" aria-label="{{ 'products.gallery_thumbnails' | t }}" aria-roledescription="carousel">
          {%- for media in product.media -%}
            {%- assign loading_strategy = 'lazy' -%}
            {%- assign fetchpriority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign loading_strategy = 'eager' -%}
              {%- assign fetchpriority = 'high' -%}
            {%- endif -%}
            <div
              class="product-gallery__main-item{% if forloop.first %} is-active{% endif %}"
              id="GalleryItem-{{ section.id }}-{{ media.id }}"
              role="group"
              aria-roledescription="slide"
              aria-labelledby="Thumb-{{ section.id }}-{{ media.id }}"
              data-gallery-main-item
              data-media-id="{{ media.id }}"
              data-media-type="{{ media.media_type }}"
            >
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, poster: media.preview_image, image_size: '900x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: autoplay: false }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: image_size: '900x', reveal: 'interaction' }}
                {%- else -%}
                  {%- assign focal_point = media.preview_image.presentation.focal_point -%}
                  {%- assign focal_style = 'object-position: ' | append: focal_point.x | append: '% ' | append: focal_point.y | append: '%' -%}
                  {{ media.preview_image | image_url: width: 900 | image_tag: loading: loading_strategy, fetchpriority: fetchpriority, widths: '450, 600, 900', sizes: '(min-width: 750px) 50vw, 100vw', style: focal_style }}
                  <button type="button" class="product-gallery__zoom-trigger" data-gallery-zoom-trigger data-media-id="{{ media.id }}" aria-label="{{ 'products.gallery_zoom' | t }}">
                    {%- render 'icon-search' -%}
                  </button>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs" role="tablist" aria-label="{{ 'products.gallery_thumbnails' | t }}">
            {%- for media in product.media -%}
              <button
                type="button"
                id="Thumb-{{ section.id }}-{{ media.id }}"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{{ forloop.first }}"
                aria-controls="GalleryItem-{{ section.id }}-{{ media.id }}"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                aria-label="{{ 'products.gallery_view_image' | t }} {{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="product-gallery__thumb-play" aria-hidden="true">{%- render 'icon-play' -%}</span>
                  <span class="visually-hidden">{{ 'products.gallery_play_video' | t }}</span>
                {%- elsif media.media_type == 'model' -%}
                  <span class="product-gallery__thumb-play" aria-hidden="true">{%- render 'icon-3d' -%}</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <dialog class="product-gallery__zoom" data-gallery-zoom-dialog aria-label="{{ 'products.gallery_zoom' | t }}">
          <button type="button" class="product-gallery__zoom-close" data-gallery-zoom-close aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon-close' -%}</button>
          <button type="button" class="product-gallery__zoom-nav product-gallery__zoom-nav--prev" data-gallery-zoom-prev aria-label="{{ 'products.gallery_previous' | t }}">{%- render 'icon-chevron-left' -%}</button>
          <div class="product-gallery__zoom-stage" data-gallery-zoom-stage>
            {%- for media in product.media -%}
              {%- unless media.media_type == 'image' %}{% continue %}{% endunless -%}
              <img
                class="product-gallery__zoom-image"
                data-gallery-zoom-image
                data-media-id="{{ media.id }}"
                src="{{ media.preview_image | image_url: width: 1800 }}"
                width="{{ media.preview_image.width }}"
                height="{{ media.preview_image.height }}"
                alt="{{ media.alt | escape }}"
                loading="lazy"
                hidden
              >
            {%- endfor -%}
          </div>
          <button type="button" class="product-gallery__zoom-nav product-gallery__zoom-nav--next" data-gallery-zoom-next aria-label="{{ 'products.gallery_next' | t }}">{%- render 'icon-chevron-right' -%}</button>
        </dialog>
      {%- else -%}
        <div class="product-gallery__main">
          <div class="product-gallery__main-item is-active">
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-buybox" id="ProductBuyBox-{{ section.id }}" data-product-buybox>
      {%- render 'product-buybox', product: product, current_variant: current_variant, section: section -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'specifications' -%}
            {%- if specs.size > 0 -%}
              <div class="product-specs" {{ block.shopify_attributes }}>
                <h2 class="product-specs__heading">{{ 'products.specifications' | t }}</h2>
                <dl>
                  {%- for pair in specs -%}
                    <div class="product-specs__row">
                      <dt>{{ pair[0] | replace: '_', ' ' | capitalize }}</dt>
                      <dd>{{ pair[1].value }}</dd>
                    </div>
                  {%- endfor -%}
                </dl>
              </div>
            {%- endif -%}
          {%- when 'accordion' -%}
            <div class="product-accordions" {{ block.shopify_attributes }}>
              {%- render 'accordion', title: block.settings.title, content: block.settings.content -%}
            </div>
          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- if settings.show_sticky_atc_mobile -%}
  <div class="sticky-atc" data-sticky-atc-bar>
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      {%- render 'price', product: product, variant: current_variant -%}
    </div>
    <button
      type="submit"
      form="ProductForm-{{ section.id }}"
      class="btn btn-primary"
      data-sticky-atc
      data-label-add="{{ 'products.add_to_cart' | t }}"
      data-label-sold-out="{{ 'products.sold_out' | t }}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
    </button>
  </div>
{%- endif -%}

<script type="application/json" data-product-json>
  {
    "url": {{ product.url | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "featured_media_id": {{ variant.featured_media.id | json }},
          "options": {{ variant.options | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<style>
  /* .breadcrumb itself now lives in base.css (Milestone 6) — it's shared
     with the article and page templates, so it moved out of this
     section-scoped block (same reasoning as the quantity stepper in
     Milestone 5). */

  #shopify-section-{{ section.id }} .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-block: 24px;
  }
  #shopify-section-{{ section.id }} .product-gallery__main {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .product-gallery__main::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .product-gallery__main:focus-visible { outline: var(--focus-ring); outline-offset: -2px; }
  #shopify-section-{{ section.id }} .product-gallery__main-item {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    aspect-ratio: var(--ratio-square);
    background: var(--surface-2);
  }
  #shopify-section-{{ section.id }} .product-gallery__main-item img,
  #shopify-section-{{ section.id }} .product-gallery__main-item svg,
  #shopify-section-{{ section.id }} .product-gallery__main-item video,
  #shopify-section-{{ section.id }} .product-gallery__main-item iframe,
  #shopify-section-{{ section.id }} .product-gallery__main-item model-viewer { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  #shopify-section-{{ section.id }} .product-gallery__zoom-trigger {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    color: var(--text);
    cursor: zoom-in;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out-slow);
  }
  #shopify-section-{{ section.id }} .product-gallery__zoom-trigger svg { width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .product-gallery__main-item:hover .product-gallery__zoom-trigger,
  #shopify-section-{{ section.id }} .product-gallery__zoom-trigger:focus-visible { opacity: 1; }
  @media (hover: none) {
    #shopify-section-{{ section.id }} .product-gallery__zoom-trigger { opacity: 1; }
  }
  #shopify-section-{{ section.id }} .product-gallery__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; }
  #shopify-section-{{ section.id }} .product-gallery__thumb {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--surface-2);
    cursor: pointer;
    opacity: .6;
  }
  #shopify-section-{{ section.id }} .product-gallery__thumb.is-active { opacity: 1; border-color: var(--text); }
  #shopify-section-{{ section.id }} .product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .product-gallery__thumb-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cta-bg);
    background: rgba(0, 0, 0, .35);
  }
  #shopify-section-{{ section.id }} .product-gallery__thumb-play svg { width: 18px; height: 18px; }

  .reduced-motion #shopify-section-{{ section.id }} .product-gallery__main { scroll-behavior: auto; }

  /* ---------- zoom dialog (native <dialog>, no library) ---------- */
  #shopify-section-{{ section.id }} .product-gallery__zoom {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
  }
  #shopify-section-{{ section.id }} .product-gallery__zoom::backdrop { background: var(--bg); }
  #shopify-section-{{ section.id }} .product-gallery__zoom[open] { display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .product-gallery__zoom-stage { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  #shopify-section-{{ section.id }} .product-gallery__zoom-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--dur-base) var(--ease-out-slow);
    touch-action: pinch-zoom;
  }
  #shopify-section-{{ section.id }} .product-gallery__zoom-image.is-zoomed { cursor: zoom-out; transform: scale(2); }
  #shopify-section-{{ section.id }} .product-gallery__zoom-close,
  #shopify-section-{{ section.id }} .product-gallery__zoom-nav {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    color: var(--text);
    cursor: pointer;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .product-gallery__zoom-close svg,
  #shopify-section-{{ section.id }} .product-gallery__zoom-nav svg { width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .product-gallery__zoom-close { top: 16px; right: 16px; }
  #shopify-section-{{ section.id }} .product-gallery__zoom-nav--prev { left: 16px; top: 50%; transform: translateY(-50%); }
  #shopify-section-{{ section.id }} .product-gallery__zoom-nav--next { right: 16px; top: 50%; transform: translateY(-50%); }

  #shopify-section-{{ section.id }} .product-buybox { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  #shopify-section-{{ section.id }} .product-buybox[aria-busy="true"] { opacity: .6; pointer-events: none; }
  #shopify-section-{{ section.id }} .product-buybox__title { font-size: 24px; }
  #shopify-section-{{ section.id }} .product-buybox .pcard__price { font-size: 16px; color: var(--text); }
  #shopify-section-{{ section.id }} .product-buybox__form { display: flex; flex-direction: column; gap: 18px; width: 100%; margin-top: 6px; }
  #shopify-section-{{ section.id }} .option-selector { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  #shopify-section-{{ section.id }} .option-selector legend { padding: 0; }
  #shopify-section-{{ section.id }} .option-selector__values { display: flex; flex-wrap: wrap; gap: 8px; }
  #shopify-section-{{ section.id }} .option-selector__pill {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--border-strong);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .option-selector__input:checked + .option-selector__pill {
    background: var(--cta-bg);
    color: var(--cta-text);
    border-color: var(--cta-bg);
  }
  #shopify-section-{{ section.id }} .option-selector__input:focus-visible + .option-selector__pill,
  #shopify-section-{{ section.id }} .option-selector__input:focus-visible + .option-selector__swatch {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .option-selector__swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    cursor: pointer;
    display: inline-block;
  }
  #shopify-section-{{ section.id }} .option-selector__input:checked + .option-selector__swatch {
    outline: 1px solid var(--text);
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .option-selector__pill.is-unavailable { opacity: .35; text-decoration: line-through; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .option-selector__swatch.is-unavailable { opacity: .3; cursor: not-allowed; }

  #shopify-section-{{ section.id }} .product-buybox__quantity { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  /* .quantity-stepper itself now lives in base.css (Milestone 5) — it's
     shared with cart line items, so it moved out of this section-scoped
     block to stay a single, unscoped, cross-cutting primitive. */

  #shopify-section-{{ section.id }} .product-buybox__shipping-note { font-size: 12px; color: var(--muted); margin-top: -6px; }
  #shopify-section-{{ section.id }} .product-buybox__description { color: var(--muted); font-size: 14px; line-height: 1.6; margin-top: 8px; }

  #shopify-section-{{ section.id }} .star-rating { margin-top: -6px; }

  #shopify-section-{{ section.id }} .product-info { border-top: 1px solid var(--border); margin-top: 20px; padding-top: 8px; }
  #shopify-section-{{ section.id }} .product-specs { padding-block: 18px; border-bottom: 1px solid var(--border); }
  #shopify-section-{{ section.id }} .product-specs__heading { font-family: var(--font-display); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .product-specs dl { display: grid; gap: 10px; }
  #shopify-section-{{ section.id }} .product-specs__row { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  #shopify-section-{{ section.id }} .product-specs__row dt { color: var(--muted); }
  #shopify-section-{{ section.id }} .product-specs__row dd { margin: 0; text-align: right; }

  #shopify-section-{{ section.id }} .product-accordions .accordion { border-bottom: 1px solid var(--border); }
  #shopify-section-{{ section.id }} .accordion__trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: .04em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .accordion__trigger::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .accordion__trigger svg { width: 16px; height: 16px; transition: transform var(--dur-fast) var(--ease-out-slow); }
  #shopify-section-{{ section.id }} .accordion[open] .accordion__trigger svg { transform: rotate(45deg); }
  #shopify-section-{{ section.id }} .accordion__content { padding-bottom: 18px; color: var(--muted); font-size: 14px; line-height: 1.6; }

  .sticky-atc {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .sticky-atc__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sticky-atc__title { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sticky-atc .btn { flex-shrink: 0; }

  @media (max-width: 749px) {
    .sticky-atc { display: flex; }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-layout { grid-template-columns: 1.1fr 1fr; gap: 48px; }
  }
</style>

{% schema %}
{
  "name": "Product information",
  "blocks": [
    {
      "type": "specifications",
      "name": "Specifications",
      "settings": [
        { "type": "paragraph", "content": "Reads the product's \"specs\" metafield namespace (Settings > Custom data > Products), one metafield per spec row. Renders nothing if none are defined." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        { "type": "specifications" },
        { "type": "accordion", "settings": { "title": "Features" } },
        { "type": "accordion", "settings": { "title": "Materials & Care" } },
        { "type": "accordion", "settings": { "title": "Shipping & Returns" } }
      ]
    }
  ]
}
{% endschema %}
