{% assign journal_image = section.settings.image %}
<section class="journal-banner" style="--journal-image:url({% if journal_image %}{{ journal_image | image_url: width: 1800 }}{% else %}{{ 'hero-slide-3.jpg' | asset_url }}{% endif %});{% if section.settings.mobile_image %}--journal-image-mobile:url({{ section.settings.mobile_image | image_url: width: 900 }});{% endif %}">
  <div class="journal-banner__copy"><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.body }}</div>{% if section.settings.cta_label != blank %}<a href="{{ section.settings.cta_url | default: routes.search_url }}">{{ section.settings.cta_label }} <span aria-hidden="true">&rarr;</span></a>{% endif %}</div>
  <blockquote><p>&ldquo;{{ section.settings.quote }}&rdquo;</p><footer><span></span>{{ section.settings.journal_label }}<small>{{ section.settings.volume_label }}</small></footer></blockquote>
</section>
<style>
#shopify-section-{{ section.id }} .journal-banner { position:relative; min-height:500px; display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; padding:clamp(2rem,6vw,5rem); overflow:hidden; background-image:linear-gradient(90deg,rgba(0,0,0,.55),rgba(0,0,0,.1) 70%),var(--journal-image); background-position:center; background-size:cover; color:#fff; }
#shopify-section-{{ section.id }} .journal-banner__copy,#shopify-section-{{ section.id }} blockquote { position:relative; z-index:1; max-width:25rem; }
#shopify-section-{{ section.id }} .journal-banner h2 { max-width:7ch; margin:0 0 1.25rem; font-family:var(--font-display); font-size:clamp(3rem,6vw,6rem); letter-spacing:-.04em; line-height:.9; text-transform:uppercase; }
#shopify-section-{{ section.id }} .journal-banner__copy div { color:rgba(255,255,255,.82); line-height:1.55; }
#shopify-section-{{ section.id }} .journal-banner a { display:inline-flex; gap:.5rem; margin-top:1.5rem; border-bottom:1px solid currentColor; color:#fff; font-size:.72rem; font-weight:600; letter-spacing:var(--tracking-label); text-decoration:none; text-transform:uppercase; }
#shopify-section-{{ section.id }} .journal-banner a:focus-visible { outline:var(--focus-ring); outline-offset:var(--focus-ring-offset); }
#shopify-section-{{ section.id }} blockquote { align-self:center; margin:0; padding:0; text-align:right; }
#shopify-section-{{ section.id }} blockquote p { margin:0; font-family:var(--font-editorial); font-size:clamp(1.8rem,3.5vw,3.5rem); font-style:italic; line-height:1.05; }
#shopify-section-{{ section.id }} blockquote footer { display:flex; align-items:center; justify-content:flex-end; gap:.7rem; margin-top:1.5rem; font-family:var(--font-display); font-size:.68rem; letter-spacing:var(--tracking-label); text-transform:uppercase; }
#shopify-section-{{ section.id }} blockquote footer span { width:3rem; border-top:1px solid currentColor; }
#shopify-section-{{ section.id }} blockquote small { color:rgba(255,255,255,.7); font-size:inherit; }
@media (max-width:749px) { #shopify-section-{{ section.id }} .journal-banner { min-height:560px; flex-direction:column; align-items:flex-start; justify-content:flex-end; background-image:linear-gradient(0deg,rgba(0,0,0,.62),rgba(0,0,0,.08) 75%),var(--journal-image-mobile,var(--journal-image)); } #shopify-section-{{ section.id }} blockquote { align-self:stretch; text-align:left; } #shopify-section-{{ section.id }} blockquote footer { justify-content:flex-start; } }
</style>
{% schema %}
{"name":"Journal banner","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"heading","label":"Heading","default":"A LIFE\nMORE OPEN"},{"type":"richtext","id":"body","label":"Body","default":"<p>Stories, guides and perspectives from those who choose a wilder path.</p>"},{"type":"text","id":"cta_label","label":"CTA label","default":"EXPLORE THE JOURNAL"},{"type":"url","id":"cta_url","label":"CTA URL"},{"type":"textarea","id":"quote","label":"Quote","default":"Not escape. Perspective."},{"type":"text","id":"journal_label","label":"Journal label","default":"AERA JOURNAL"},{"type":"text","id":"volume_label","label":"Volume label","default":"VOL. 04"}],"presets":[{"name":"Journal banner"}]}
{% endschema %}
