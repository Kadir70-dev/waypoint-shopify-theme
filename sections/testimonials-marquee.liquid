ype":"testimonial","settings":{"quote":"Built like expedition equipment without feeling like expedition equipment.","name":"JONAH K.","metadata":"WEEKEND EXPLORER · DEMO REVIEW","location":"SCOTLAND","background":"#24251F","text_color":"#F5F4EF","rotation":1}},{"type":"testimonial","settings":{"quote":"I've carried it through airports, forests and long approaches. It works everywhere without looking out of place.","name":"AMELIA S.","metadata":"TRAVEL PHOTOGRAPHER · DEMO REVIEW","location":"CANADA","background":"#C6B18D"}},{"type":"testimonial","settings":{"quote":"The first thing I noticed was the balance. The second was how little I noticed the pack after six hours.","name":"NOAH B.","metadata":"HIKER · DEMO REVIEW","location":"SWITZERLAND","background":"#8A8778"}},{"type":"testimonial","settings":{"quote":"Simple where it should be simple. Technical where it actually matters.","name":"LENA M.","metadata":"OUTDOOR CREATIVE · DEMO REVIEW","location":"GERMANY","background":"#6B4F43","text_color":"#F5F4EF"}},{"type":"testimonial","settings":{"quote":"It handled wind, dust and a very long weekend without asking for any attention.","name":"ADAM C.","metadata":"FIELD TESTER · DEMO REVIEW","location":"ICELAND","background":"#59636A","text_color":"#F5F4EF"}},{"type":"testimonial","settings":{"quote":"There's a confidence to equipment that has clearly been designed by people who actually use it.","name":"SOFIA N.","metadata":"CLIMBER · DEMO REVIEW","location":"ITALY","background":"#4A5138","text_color":"#F5F4EF"}}]}]}
{% endschema %}
