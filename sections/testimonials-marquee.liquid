{%- assign speed = section.settings.speed -%}
<section class="testimonials-marquee" aria-labelledby="TestimonialsMarquee-{{ section.id }}">
  <div class="testimonials-marquee__intro">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="TestimonialsMarquee-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.supporting_text }}</p>
  </div>
  <div class="testimonials-marquee__viewport">
    <div class="testimonials-marquee__track testimonials-marquee__track--{{ speed }}">
      {% for duplicate in (1..2) %}<div class="testimonials-marquee__set"{% if duplicate == 2 %} aria-hidden="true"{% endif %}>{% for block in section.blocks %}<article class="testimonials-marquee__card" style="--card-bg:{{ block.settings.background }};--card-text:{{ block.settings.text_color }};--rotation:{{ block.settings.rotation }}deg"{% if duplicate == 1 %} {{ block.shopify_attributes }}{% endif %}>{% if block.settings.image %}<img class="testimonials-marquee__avatar" src="{{ block.settings.image | image_url: width: 100 }}" alt="" width="40" height="40">{% endif %}<span class="testimonials-marquee__quote-mark" aria-hidden="true">&ldquo;</span><p class="testimonials-marquee__quote">{{ block.settings.quote }}</p><div class="testimonials-marquee__meta"><span class="testimonials-marquee__name">{{ block.settings.name }}</span><span class="testimonials-marquee__details"><span>{{ block.settings.metadata }}<br>{{ block.settings.location }}</span><span class="testimonials-marquee__stars"{% if duplicate == 1 %} aria-label="{{ block.settings.rating }} out of 5 stars"{% endif %}>{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</span></span></div></article>{% endfor %}</div>{% endfor %}
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }} .testimonials-marquee { overflow:hidden; padding:clamp(4rem,8vw,7rem) 0; background:var(--bg); color:var(--text); }
#shopify-section-{{ section.id }} .testimonials-marquee__intro { width:min(600px,calc(100% - 3rem)); margin:0 auto clamp(2.5rem,5vw,4rem); }
#shopify-section-{{ section.id }} .testimonials-marquee__intro h2 { max-width:10ch; margin:.75rem 0 1.25rem; font-family:var(--font-display); font-size:clamp(3rem,6vw,6rem); letter-spacing:-.04em; line-height:.9; text-transform:uppercase; }
#shopify-section-{{ section.id }} .testimonials-marquee__intro > p:last-child { max-width:25rem; margin:0; color:var(--muted); line-height:1.5; }
#shopify-section-{{ section.id }} .testimonials-marquee__viewport { width:100%; overflow:hidden; }
#shopify-section-{{ section.id }} .testimonials-marquee__track { display:flex; width:max-content; animation: testimonials-marquee-left 42s linear infinite; will-change:transform; }
#shopify-section-{{ section.id }} .testimonials-marquee__track--slow { animation-duration:52s; }
#shopify-section-{{ section.id }} .testimonials-marquee__track--fast { animation-duration:32s; }
#shopify-section-{{ section.id }} .testimonials-marquee__set { display:flex; align-items:stretch; gap:1rem; padding-right:1rem; }
#shopify-section-{{ section.id }} .testimonials-marquee__card { position:relative; flex:0 0 300px; min-height:255px; display:flex; flex-direction:column; justify-content:space-between; padding:1.75rem; border:1px solid color-mix(in srgb,var(--card-text) 18%,transparent); border-radius:var(--radius); background:var(--card-bg); color:var(--card-text); transform:rotate(var(--rotation)); }
#shopify-section-{{ section.id }} .testimonials-marquee__quote-mark { position:absolute; top:.8rem; left:1.35rem; font-family:var(--font-editorial); font-size:4rem; line-height:1; opacity:.18; }
#shopify-section-{{ section.id }} .testimonials-marquee__quote { position:relative; z-index:1; margin:1.5rem 0 2rem; font-family:var(--font-editorial); font-size:1.12rem; line-height:1.42; }
#shopify-section-{{ section.id }} .testimonials-marquee__meta { padding-top:1rem; border-top:1px solid color-mix(in srgb,var(--card-text) 24%,transparent); font-family:var(--font-display); font-size:.67rem; letter-spacing:var(--tracking-label); line-height:1.45; text-transform:uppercase; }
#shopify-section-{{ section.id }} .testimonials-marquee__name { display:block; margin-bottom:.2rem; font-size:.82rem; letter-spacing:.12em; }
#shopify-section-{{ section.id }} .testimonials-marquee__details { display:flex; justify-content:space-between; gap:.75rem; opacity:.7; }
#shopify-section-{{ section.id }} .testimonials-marquee__stars { letter-spacing:.08em; white-space:nowrap; }
#shopify-section-{{ section.id }} .testimonials-marquee__avatar { width:2.5rem; height:2.5rem; margin-bottom:.75rem; border-radius:50%; object-fit:cover; }
#shopify-section-{{ section.id }} .testimonials-marquee__track:hover,#shopify-section-{{ section.id }} .testimonials-marquee__track:focus-within { animation-play-state:paused; }
@keyframes testimonials-marquee-left { from { transform:translateX(0); } to { transform:translateX(-50%); } }
@media (max-width:749px) { #shopify-section-{{ section.id }} .testimonials-marquee__intro { width:calc(100% - 3rem); } #shopify-section-{{ section.id }} .testimonials-marquee__track { animation-duration:58s; } #shopify-section-{{ section.id }} .testimonials-marquee__track--slow { animation-duration:72s; } #shopify-section-{{ section.id }} .testimonials-marquee__track--fast { animation-duration:46s; } #shopify-section-{{ section.id }} .testimonials-marquee__card { flex-basis:84vw; min-height:240px; } }
@media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .testimonials-marquee__track { animation:none; transform:none; overflow-x:auto; scroll-snap-type:x proximity; } #shopify-section-{{ section.id }} .testimonials-marquee__set[aria-hidden="true"] { display:none; } #shopify-section-{{ section.id }} .testimonials-marquee__card { scroll-snap-align:start; } }
</style>

{% schema %}
