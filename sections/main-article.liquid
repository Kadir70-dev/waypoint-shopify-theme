{%- comment -%}
  Waypoint — single article page. Comments follow Shopify's native pattern:
  paginated article.comments plus a new_comment form, shown only when the
  blog has comments enabled.
{%- endcomment -%}
{%- comment -%}
  Article structured data (Milestone 8 SEO). Real Shopify article fields
  only; author is emitted as a plain Person name (Shopify's article.author
  is a string, no separate profile data exists to fabricate).
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  {%- if article.author != blank %}
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  {%- endif %}
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1400 | prepend: "https:" | json }}],
  {%- endif %}
  "description": {{ article.excerpt_or_content | strip_html | truncatewords: 40 | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
}
</script>
<div class="section page-width">
  <div class="article-header" data-reveal>
    {%- render 'breadcrumb', blog: blog, article: article -%}
    <span class="eyebrow">
      {%- if article.tags.size > 0 -%}{{ article.tags.first }}{%- else -%}{{ blog.title }}{%- endif -%}
    </span>
    <h1 style="font-size:clamp(28px,4vw,42px)">{{ article.title }}</h1>
    <p class="article-meta">
      {{ article.published_at | date: '%B %d, %Y' }}
      {%- if article.author != blank %} &middot; {{ article.author }}{%- endif -%}
    </p>
  </div>

  {%- if article.image -%}
    <div class="article-hero" data-reveal>
      {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700, 1000, 1400', sizes: '100vw', alt: article.image.alt | default: article.title }}
    </div>
  {%- endif -%}

  <div class="article-body rte" data-reveal>
    {{ article.content }}
  </div>

  {%- if article.tags.size > 0 -%}
    <div class="article-tags">
      {%- for tag in article.tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <nav class="article-nav" aria-label="{{ 'sections.journal.article_navigation' | t }}">
    {%- if article.previous_article -%}
      <a href="{{ article.previous_article.url }}" class="article-nav__prev">
        {{ 'general.arrow_back' | t }} {{ article.previous_article.title }}
      </a>
    {%- else -%}
      <span></span>
    {%- endif -%}
    {%- if article.next_article -%}
      <a href="{{ article.next_article.url }}" class="article-nav__next">
        {{ article.next_article.title }} {{ 'general.arrow_forward' | t }}
      </a>
    {%- endif -%}
  </nav>

  {%- if blog.comments_enabled? -%}
    <section class="article-comments" id="comments" aria-labelledby="ArticleCommentsHeading">
      <h2 id="ArticleCommentsHeading" class="article-comments__heading">{{ 'comments.heading' | t }}</h2>

      {%- paginate article.comments by 5 -%}
        {%- if article.comments_count > 0 -%}
          <ul class="article-comments__list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px">
            {%- for comment in article.comments -%}
              <li id="Comment-{{ comment.id }}">
                <p class="eyebrow" style="margin:0 0 6px">{{ comment.author }} &middot; {{ comment.created_at | time_tag: format: 'date' }}</p>
                <div class="rte">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article -%}
        <h3 class="article-comments__form-heading">{{ 'comments.form_heading' | t }}</h3>
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">
            {%- if blog.moderated? -%}{{ 'comments.success_moderated' | t }}{%- else -%}{{ 'comments.success' | t }}{%- endif -%}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-message" role="alert">
            {%- for field in form.errors -%}
              <p>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="field">
          <label for="CommentAuthor" class="eyebrow">{{ 'comments.name_label' | t }}</label>
          <input type="text" id="CommentAuthor" name="comment[author]" class="field__input" value="{{ form.author }}" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="CommentEmail" class="eyebrow">{{ 'comments.email_label' | t }}</label>
          <input type="email" id="CommentEmail" name="comment[email]" class="field__input" value="{{ form.email }}" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="CommentBody" class="eyebrow">{{ 'comments.body_label' | t }}</label>
          <textarea id="CommentBody" name="comment[body]" class="field__input" rows="5" required>{{ form.body }}</textarea>
        </div>
        {%- if blog.moderated? -%}
          <p class="muted" style="font-size:12px">{{ 'comments.moderated_notice' | t }}</p>
        {%- endif -%}
        <button type="submit" class="btn btn-primary">{{ 'comments.submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Article"
}
{% endschema %}
