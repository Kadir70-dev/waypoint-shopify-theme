{%- comment -%}
  A single full-bleed band pairing a promo photo (left) with a featured
  product panel (right) — the "Details That Perform / Summit 45" homepage
  row. Two independent messages that read as one visual unit, so they're
  one section rather than two stacked ones.
{%- endcomment -%}
{%- assign product = section.settings.product -%}
{%- liquid
  assign promo_mobile_url = blank
  assign promo_desktop_url = blank
  assign promo_bg_position = blank
  if section.settings.image
    assign promo_mobile_url = section.settings.image | image_url: width: 800
    assign promo_desktop_url = section.settings.image | image_url: width: 1400
    assign promo_focal_point = section.settings.image.presentation.focal_point
    if promo_focal_point
      assign promo_bg_position = promo_focal_point.x | append: '% ' | append: promo_focal_point.y | append: '%'
    endif
  endif
-%}
<div class="feature-spotlight" data-reveal-group>
  <div class="photo brand feature-spotlight__promo" data-reveal {% if section.settings.image %}style="--bg-mobile:url({{ promo_mobile_url }});--bg-desktop:url({{ promo_desktop_url }}){% if promo_bg_position %};--bg-position:{{ promo_bg_position }}{% endif %}"{% endif %}>
    <div class="feature-spotlight__promo-content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="color:#ddd">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 style="font-size:26px;color:#fff">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div style="color:#ddd;font-size:14px;line-height:1.6">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-outline" style="align-self:flex-start;margin-top:6px">
          {{ section.settings.cta_label }} &rarr;
        </a>
      {%- endif -%}
    </div>

    {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
    {%- if feature_blocks.size > 0 -%}
      <ul class="feature-spotlight__list">
        {%- for block in feature_blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if product != blank -%}
    <div class="feature-spotlight__product" data-reveal>
      <div class="feature-spotlight__product-body">
        <span class="eyebrow">{{ section.settings.product_eyebrow }}</span>
        <h3 style="font-size:22px">{{ product.title }}</h3>
        {%- if section.settings.product_text != blank -%}
          <p style="color:var(--muted);font-size:14px">{{ section.settings.product_text }}</p>
        {%- endif -%}
        {%- render 'price', product: product -%}
        <a href="{{ product.url }}" class="btn btn-primary" style="align-self:flex-start;margin-top:4px">
          {{ section.settings.product_cta_label }} &rarr;
        </a>
      </div>
      <div class="feature-spotlight__product-media">
        {%- if section.settings.product_image_override -%}
          {{ section.settings.product_image_override | image_url: width: 500 | image_tag: loading: 'lazy', widths: '300, 500', sizes: '(min-width: 990px) 33vw, 80vw', alt: product.title }}
        {%- elsif product.featured_image -%}
          {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '300, 500', sizes: '(min-width: 990px) 33vw, 80vw', alt: product.title }}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }} .feature-spotlight {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--bg);
  }
  #shopify-section-{{ section.id }} .feature-spotlight__promo {
    position: relative;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 32px;
    background-image: var(--bg-mobile, none);
  }
  #shopify-section-{{ section.id }} .feature-spotlight__promo::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, .75) 0%, rgba(0, 0, 0, .1) 60%);
  }
  #shopify-section-{{ section.id }} .feature-spotlight__promo-content {
    position: relative;
    z-index: 1;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .feature-spotlight__list {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #ddd;
    text-align: end;
  }
  #shopify-section-{{ section.id }} .feature-spotlight__product {
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
  }
  #shopify-section-{{ section.id }} .feature-spotlight__product-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  #shopify-section-{{ section.id }} .feature-spotlight__product-media { align-self: center; max-width: 220px; }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .feature-spotlight { grid-template-columns: 1.9fr 1fr; }
    #shopify-section-{{ section.id }} .feature-spotlight__promo { min-height: 460px; padding: 48px; background-image: var(--bg-desktop, none); }
    #shopify-section-{{ section.id }} .feature-spotlight__product { flex-direction: row; align-items: center; justify-content: center; }
    #shopify-section-{{ section.id }} .feature-spotlight__product-body { flex: 1 1 140px; }
    #shopify-section-{{ section.id }} .feature-spotlight__product-media { flex: 1 1 140px; max-width: none; }
  }
</style>

{% schema %}
{
  "name": "Feature spotlight",
  "settings": [
    { "type": "header", "content": "Promo panel" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Engineered for Extremes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Details That Perform" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From alpine ridges to dense forests, every element is designed with purpose. Premium materials. Rigorously tested. No compromises.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Our Approach" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Product panel" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "product_image_override", "label": "Image override", "info": "Uses the product's featured image if left blank." },
    { "type": "text", "id": "product_eyebrow", "label": "Eyebrow", "default": "Featured Gear" },
    { "type": "text", "id": "product_text", "label": "Text", "default": "All-terrain backpack for multi-day missions." },
    { "type": "text", "id": "product_cta_label", "label": "Button label", "default": "View Product" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Label", "default": "Waterproof" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature spotlight",
      "blocks": [
        { "type": "feature", "settings": { "text": "Waterproof" } },
        { "type": "feature", "settings": { "text": "Breathable" } },
        { "type": "feature", "settings": { "text": "Durable" } },
        { "type": "feature", "settings": { "text": "Lightweight" } },
        { "type": "feature", "settings": { "text": "Field Tested" } }
      ]
    }
  ]
}
{% endschema %}
