<div class="section page-width" data-reveal-group>
  <div class="section-heading">
    <div>
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.show_view_all -%}
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="section-heading__view-all">
        {{ 'general.view_all' | t }} &rarr;
      </a>
    {%- endif -%}
  </div>

  <div class="product-grid" data-context="featured">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {%- render 'card-product', product: product -%}
      {%- endfor -%}
    {%- else -%}
      {%- render 'card-product-demo', image: 'latest-ridge-shell.png', title: 'Ridge Shell Jacket', price: '€249,00', swatches: '#2b2b2b,#5C6B4A' -%}
      {%- render 'card-product-demo', image: 'latest-terrain-boot.png', title: 'Terrain Mid Boot', price: '€179,00', swatches: '#6b4a2f,#2b2b2b' -%}
      {%- render 'card-product-demo', image: 'latest-altitude-backpack.png', title: 'Altitude 35 Backpack', price: '€229,00', swatches: '#5C6B4A,#B99A6B' -%}
      {%- render 'card-product-demo', image: 'latest-field-cook.png', title: 'Field Cook System', price: '€89,00', swatches: '#2b2b2b,#B99A6B' -%}
      {%- render 'card-product-demo', image: 'latest-tactical-light.png', title: 'Nova Tactical Light', price: '€129,00', swatches: '#2b2b2b,#5C6B4A' -%}
      {%- render 'card-product-demo', image: 'latest-ember-hoodie.png', title: 'Ember Insulated Hoodie', price: '€199,00', swatches: '#2b2b2b,#6b4a2f' -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Releases" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New gear for longer days." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"view all\" link", "default": true }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
