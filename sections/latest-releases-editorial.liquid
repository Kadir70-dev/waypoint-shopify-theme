{% liquid
  assign collection = section.settings.collection
  assign show_products = section.settings.products_to_show
  assign swatch_option_name = settings.product_card_swatch_option | default: 'Color'
%}

<section class="latest-releases latest-releases--{{ section.settings.spacing }}" id="LatestReleases-{{ section.id }}" data-latest-releases>
  <div class="latest-releases__inner">
    <header class="latest-releases__header">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="latest-releases__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.title != blank %}<h2 class="latest-releases__title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.supporting_text != blank %}<p class="latest-releases__intro">{{ section.settings.supporting_text | escape }}</p>{% endif %}
      </div>
      {% if section.settings.show_view_all and collection != blank %}
        <a class="latest-releases__view-all" href="{{ collection.url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </header>

    <div class="latest-releases__rail" role="list" tabindex="0">
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: show_products %}
          {% liquid
            assign variant = product.selected_or_first_available_variant
            assign color_option = product.options_with_values | where: 'name', swatch_option_name | first
            assign compare_at = variant.compare_at_price
          %}
          <article class="latest-releases__item{% unless forloop.first %} latest-releases__item--separated{% endunless %}" role="listitem">
            <a class="latest-releases__product-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <div class="latest-releases__media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 500, 800', sizes: '(min-width: 990px) 16vw, 70vw', alt: product.featured_image.alt | default: product.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'latest-releases__placeholder' }}
                {% endif %}
              </div>
              <div class="latest-releases__details">
                <h3>{{ product.title | escape }}</h3>
                {% if section.settings.show_price %}
                  <p class="latest-releases__price{% unless product.available %} latest-releases__price--sold-out{% endunless %}">
                    {% if section.settings.show_compare_at and compare_at > variant.price %}<s>{{ compare_at | money }}</s>{% endif %}
                    <span>{% if product.available %}{{ variant.price | money }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                  </p>
                {% endif %}
                {% if section.settings.show_swatches and color_option != blank %}
                  <span class="latest-releases__swatches" aria-label="{{ 'general.color_options' | t: name: color_option.name | escape }}">
                    {% for value in color_option.values limit: 4 %}
                      {% if value.swatch.image %}<span class="latest-releases__swatch" style="background-image:url('{{ value.swatch.image | image_url: width: 40 }}')" title="{{ value | escape }}"></span>{% elsif value.swatch.color %}<span class="latest-releases__swatch" style="background-color:{{ value.swatch.color }}" title="{{ value | escape }}"></span>{% endif %}
                    {% endfor %}
                    {% if color_option.values.size > 4 %}<span class="latest-releases__more">+{{ color_option.values.size | minus: 4 }}</span>{% endif %}
                  </span>
                {% endif %}
              </div>
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..show_products) %}
          <article class="latest-releases__item{% unless forloop.first %} latest-releases__item--separated{% endunless %}" role="listitem">
            <div class="latest-releases__media">{{ 'product-1' | placeholder_svg_tag: 'latest-releases__placeholder' }}</div>
            
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  #LatestReleases-{{ section.id }} { background: var(--bg, #111); color: var(--text, #f5f3ee); overflow: hidden; }
  #LatestReleases-{{ section.id }} .latest-releases__inner { max-width: var(--page-width, 1440px); margin: 0 auto; padding: 76px 5vw 82px; }
  #LatestReleases-{{ section.id }}.latest-releases--small .latest-releases__inner { padding-block: 54px 60px; }
  #LatestReleases-{{ section.id }}.latest-releases--large .latest-releases__inner { padding-block: 96px 104px; }
  #LatestReleases-{{ section.id }} .latest-releases__header { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 34px; }
  #LatestReleases-{{ section.id }} .latest-releases__eyebrow { margin: 0 0 10px; color: var(--muted, #a9aaa4); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
  #LatestReleases-{{ section.id }} .latest-releases__title { margin: 0; font-family: var(--font-display, inherit); font-size: clamp(28px, 3vw, 46px); line-height: .98; letter-spacing: -.035em; }
  #LatestReleases-{{ section.id }} .latest-releases__intro { margin: 12px 0 0; color: var(--muted, #a9aaa4); font-size: 14px; }
  #LatestReleases-{{ section.id }} .latest-releases__view-all { color: inherit; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  #LatestReleases-{{ section.id }} .latest-releases__view-all span { margin-inline-start: 8px; font-size: 16px; }
  #LatestReleases-{{ section.id }} .latest-releases__rail { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  #LatestReleases-{{ section.id }} .latest-releases__item { min-width: 0; }
  #LatestReleases-{{ section.id }} .latest-releases__item--separated { border-inline-start: 1px solid color-mix(in srgb, currentColor 18%, transparent); padding-inline-start: 18px; }
  #LatestReleases-{{ section.id }} .latest-releases__product-link { display: block; color: inherit; text-decoration: none; }
  #LatestReleases-{{ section.id }} .latest-releases__media { display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1.16; padding: 8px 8px 18px; overflow: hidden; }
  #LatestReleases-{{ section.id }} .latest-releases__media img, #LatestReleases-{{ section.id }} .latest-releases__placeholder { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .35s ease; }
  #LatestReleases-{{ section.id }} .latest-releases__product-link:hover .latest-releases__media img { transform: scale(1.035); }
  #LatestReleases-{{ section.id }} .latest-releases__placeholder { opacity: .2; }
  #LatestReleases-{{ section.id }} .latest-releases__details h3 { margin: 0; font-size: 11px; line-height: 1.35; letter-spacing: .08em; text-transform: uppercase; }
  #LatestReleases-{{ section.id }} .latest-releases__price { display: flex; gap: 8px; margin: 8px 0 0; color: var(--muted, #a9aaa4); font-size: 12px; }
  #LatestReleases-{{ section.id }} .latest-releases__price s { opacity: .55; }
  #LatestReleases-{{ section.id }} .latest-releases__price--sold-out { color: var(--muted, #a9aaa4); }
  #LatestReleases-{{ section.id }} .latest-releases__swatches { display: flex; align-items: center; gap: 5px; margin-top: 12px; }
  #LatestReleases-{{ section.id }} .latest-releases__swatch { display: block; width: 10px; height: 10px; border: 1px solid color-mix(in srgb, currentColor 35%, transparent); border-radius: 50%; background-size: cover; }
  #LatestReleases-{{ section.id }} .latest-releases__more { color: var(--muted, #a9aaa4); font-size: 10px; }
  #LatestReleases-{{ section.id }} a:focus-visible { outline: 1px solid currentColor; outline-offset: 5px; }
  @media (max-width: 749px) {
    #LatestReleases-{{ section.id }} .latest-releases__inner { padding: 56px 20px 62px; }
    #LatestReleases-{{ section.id }} .latest-releases__header { align-items: start; margin-bottom: 24px; }
    #LatestReleases-{{ section.id }} .latest-releases__intro { max-width: 220px; }
    #LatestReleases-{{ section.id }} .latest-releases__rail { display: flex; gap: 14px; margin-inline-end: -20px; overflow-x: auto; padding-block: 2px 12px; padding-inline: 0 20px; scroll-snap-type: x mandatory; scrollbar-width: none; }
    #LatestReleases-{{ section.id }} .latest-releases__rail::-webkit-scrollbar { display: none; }
    #LatestReleases-{{ section.id }} .latest-releases__item { flex: 0 0 68vw; scroll-snap-align: start; }
    #LatestReleases-{{ section.id }} .latest-releases__item--separated { border-inline-start: 0; padding-inline-start: 0; }
  }
</style>

{% schema %}
{
  "name": "Latest releases",
  "tag": "section",
  "class": "section-latest-releases",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LATEST RELEASES" },
    { "type": "text", "id": "title", "label": "Title", "default": "LATEST RELEASES" },
    { "type": "textarea", "id": "supporting_text", "label": "Supporting text", "default": "New gear for longer days." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 8, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true },
    { "type": "checkbox", "id": "show_compare_at", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "VIEW ALL" },
    { "type": "select", "id": "spacing", "label": "Section spacing", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" }
  ],
  "presets": [{ "name": "Latest releases" }]
}
{% endschema %}
