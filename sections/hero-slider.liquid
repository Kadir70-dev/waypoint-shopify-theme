{{ 'component-motion.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign promo_active = false
  if settings.promo_enabled and settings.promo_text != blank
    assign promo_active = true
    if settings.promo_expiry != blank
      assign promo_expiry_ts = settings.promo_expiry | date: '%s' | plus: 0
      assign promo_now_ts = 'now' | date: '%s' | plus: 0
      assign promo_end_ts = promo_expiry_ts | plus: 86399
      if promo_expiry_ts == 0 or promo_end_ts < promo_now_ts
        assign promo_active = false
      endif
    endif
  endif
-%}
<div
  class="hero-slider"
  data-hero-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  data-transition="{{ section.settings.transition_duration }}"
  style="--hero-interval:{{ section.settings.autoplay_interval | times: 1000 }}ms;--hero-transition:{{ section.settings.transition_duration }}ms"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign mobile_url = blank
      assign desktop_url = blank
      assign bg_position = blank
      if block.settings.image
        assign mobile_url = block.settings.image | image_url: width: 800
        assign desktop_url = block.settings.image | image_url: width: 1600
        assign focal_point = block.settings.image.presentation.focal_point
        if focal_point
          assign bg_position = focal_point.x | append: '% ' | append: focal_point.y | append: '%'
        endif
      elsif forloop.index == 1
        assign mobile_url = 'hero-slide-1-mobile.jpg' | asset_url
        assign desktop_url = 'hero-slide-1.jpg' | asset_url
      elsif forloop.index == 2
        assign mobile_url = 'hero-slide-2-mobile.jpg' | asset_url
        assign desktop_url = 'hero-slide-2.jpg' | asset_url
      elsif forloop.index == 3
        assign mobile_url = 'hero-slide-3-mobile.jpg' | asset_url
        assign desktop_url = 'hero-slide-3.jpg' | asset_url
      endif
    -%}
    {%- if forloop.first -%}
      {%- comment -%} The first slide's background is the LCP element: preload it so it is not discovered only after CSS. {%- endcomment -%}
      <link rel="preload" as="image" href="{{ mobile_url }}" media="(max-width: 749px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ desktop_url }}" media="(min-width: 750px)" fetchpriority="high">
    {%- endif -%}
    <div
      class="hero-slider__slide photo brand"
      data-hero-slide
      role="group"
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      {% comment %}
        Only the first (initially active) slide's background loads eagerly
        (inline custom properties, real request at paint time). Every other
        slide only carries data-bg-* — motion.js's show() sets the real
        --bg-mobile/--bg-desktop custom properties the first time that
        slide actually becomes active, so slides a visitor never reaches
        (or an autoplay-disabled reduced-motion visitor never advances to)
        never download at all. See assets/component-motion.css for the
        var(--bg-mobile)/(min-width:750px) var(--bg-desktop) rule.
      {% endcomment %}
      {% if forloop.first %}
        data-active="true"
        style="--bg-mobile:url({{ mobile_url }});--bg-desktop:url({{ desktop_url }}){% if bg_position %};--bg-position:{{ bg_position }}{% endif %}"
      {% else %}
        data-bg-mobile="{{ mobile_url }}"
        data-bg-desktop="{{ desktop_url }}"
        {% if bg_position %}data-bg-position="{{ bg_position }}"{% endif %}
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <div class="hero-slider__content">
        {%- if forloop.first and promo_active -%}
          <span class="hero-promo-chip">{{ settings.promo_text | escape }}</span>
        {%- endif -%}
        {%- if block.settings.eyebrow != blank -%}
          <span class="hero-slider__eyebrow eyebrow" style="color:rgba(255,255,255,.8)">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          {%- if forloop.first -%}{%- assign heading_tag = 'h1' -%}{%- else -%}{%- assign heading_tag = 'h2' -%}{%- endif -%}
          <{{ heading_tag }} class="hero-slider__heading" style="color:#fff;font-size:clamp(28px, 5vw, 44px)">{{ block.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if block.settings.subtext != blank -%}
          <p class="hero-slider__body" style="color:#eee">{{ block.settings.subtext }}</p>
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <a href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}" class="hero-slider__cta btn btn-primary" style="align-self:flex-start;margin-top:6px">
            {{ block.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if section.settings.tagline_word_1 != blank or section.settings.tagline_word_2 != blank or section.settings.tagline_word_3 != blank -%}
    <div class="hero-slider__corner-tag">
      <span class="hero-slider__corner-rule"></span>
      {%- if section.settings.tagline_word_1 != blank -%}<span>{{ section.settings.tagline_word_1 }}</span>{%- endif -%}
      {%- if section.settings.tagline_word_2 != blank -%}<span>{{ section.settings.tagline_word_2 }}</span>{%- endif -%}
      {%- if section.settings.tagline_word_3 != blank -%}<span>{{ section.settings.tagline_word_3 }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slider__controls" aria-label="{{ 'sections.hero.controls' | t }}">
      <div class="hero-slider__dots" data-hero-dots>
        {%- for block in section.blocks -%}
          {%- assign idx = forloop.index -%}
          <button type="button" data-hero-dot aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'sections.hero.slide' | t }} {{ idx }}">
            <span class="hero-slider__dot-label">{%- if idx < 10 -%}0{{ idx }}{%- else -%}{{ idx }}{%- endif -%}</span>
            <span class="hero-slider__dot-progress" aria-hidden="true"></span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval (seconds)", "min": 3, "max": 30, "step": 1, "default": 3 },
    { "type": "range", "id": "transition_duration", "label": "Transition duration (milliseconds)", "min": 400, "max": 1200, "step": 100, "default": 800 },
    { "type": "header", "content": "Corner tagline" },
    { "type": "text", "id": "tagline_word_1", "label": "Word 1", "default": "Explore" },
    { "type": "text", "id": "tagline_word_2", "label": "Word 2", "default": "Adapt" },
    { "type": "text", "id": "tagline_word_3", "label": "Word 3", "default": "Endure" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gear for Real Life" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Further by Nature" },
        { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Technical gear for the unknown. Built to go further." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore Gear" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        { "type": "slide", "settings": { "eyebrow": "Gear for Real Life", "heading": "Further by Nature", "subtext": "Technical gear for the unknown. Built to go further.", "cta_label": "Explore Gear" } },
        { "type": "slide", "settings": { "eyebrow": "Engineered for Extremes", "heading": "Details That Perform", "subtext": "Premium materials. Rigorously tested. No compromises.", "cta_label": "Our Approach" } },
        { "type": "slide", "settings": { "eyebrow": "Journal", "heading": "A Life More Open", "subtext": "Stories, guides and perspectives from those who choose a wilder path.", "cta_label": "Explore the Journal" } }
      ]
    }
  ]
}
{% endschema %}
