<div
  class="hero-slider"
  data-hero-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
>
  {%- for block in section.blocks -%}
    <div
      class="hero-slider__slide photo brand"
      data-hero-slide
      {% if forloop.first %}data-active="true"{% endif %}
      {% if block.settings.image %}
        style="background-image:url({{ block.settings.image | image_url: width: 1600 }})"
      {% elsif forloop.index == 1 %}
        style="background-image:url({{ 'hero-slide-1.png' | asset_url }})"
      {% elsif forloop.index == 2 %}
        style="background-image:url({{ 'hero-slide-2.png' | asset_url }})"
      {% elsif forloop.index == 3 %}
        style="background-image:url({{ 'hero-slide-3.png' | asset_url }})"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <div class="hero-slider__content">
        {%- if block.settings.eyebrow != blank -%}
          <span class="eyebrow" style="color:#ddd">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h1 style="color:#fff;font-size:clamp(28px, 5vw, 44px)">{{ block.settings.heading }}</h1>
        {%- endif -%}
        {%- if block.settings.subtext != blank -%}
          <p style="color:#eee">{{ block.settings.subtext }}</p>
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <a href="{{ block.settings.cta_link | default: '#' }}" class="btn btn-primary" style="align-self:flex-start;margin-top:6px">
            {{ block.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if section.settings.tagline_word_1 != blank or section.settings.tagline_word_2 != blank or section.settings.tagline_word_3 != blank -%}
    <div class="hero-slider__corner-tag">
      <span class="hero-slider__corner-rule"></span>
      {%- if section.settings.tagline_word_1 != blank -%}<span>{{ section.settings.tagline_word_1 }}</span>{%- endif -%}
      {%- if section.settings.tagline_word_2 != blank -%}<span>{{ section.settings.tagline_word_2 }}</span>{%- endif -%}
      {%- if section.settings.tagline_word_3 != blank -%}<span>{{ section.settings.tagline_word_3 }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slider__dots">
      {%- for block in section.blocks -%}
        {%- assign idx = forloop.index -%}
        <button
          type="button"
          data-hero-dot
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'sections.hero.slide' | t }} {{ idx }}"
        >
          {%- if idx < 10 -%}0{{ idx }}{%- else -%}{{ idx }}{%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval (seconds)", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "header", "content": "Corner tagline" },
    { "type": "text", "id": "tagline_word_1", "label": "Word 1", "default": "Explore" },
    { "type": "text", "id": "tagline_word_2", "label": "Word 2", "default": "Adapt" },
    { "type": "text", "id": "tagline_word_3", "label": "Word 3", "default": "Endure" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gear for Real Life" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Further by Nature" },
        { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Technical gear for the unknown. Built to go further." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore Gear" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide", "settings": { "eyebrow": "Gear for Real Life", "heading": "Further by Nature", "subtext": "Technical gear for the unknown. Built to go further.", "cta_label": "Explore Gear" } },
        { "type": "slide", "settings": { "eyebrow": "Engineered for Extremes", "heading": "Details That Perform", "subtext": "Premium materials. Rigorously tested. No compromises.", "cta_label": "Our Approach" } },
        { "type": "slide", "settings": { "eyebrow": "AERA Journal", "heading": "A Life More Open", "subtext": "Stories, guides and perspectives from those who choose a wilder path.", "cta_label": "Explore the Journal" } }
      ]
    }
  ]
}
{% endschema %}
