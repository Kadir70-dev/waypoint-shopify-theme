{%- comment -%}
  Rendered from within sections/header.liquid via {% section 'mega-menu' %}
  when the top-level nav link matching section.settings.trigger_label is
  hovered/clicked. v1 scope: one mega-menu panel, attached to a single
  designated top-level link (matches the approved comp, which shows the
  mega-menu on "Shop" only) — see Milestone 1 deviations note.
{%- endcomment -%}

<div
  id="MegaMenu"
  class="mega-menu"
  data-mega-menu
  role="region"
  aria-label="{{ section.settings.trigger_label | escape }}"
  data-trigger-label="{{ section.settings.trigger_label | escape }}"
  data-overlay
  data-overlay-trap="false"
  hidden
>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'menu-column' -%}
        <div class="mega-menu__column" {{ block.shopify_attributes }}>
          <h3 class="eyebrow">{{ block.settings.heading }}</h3>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>

      {%- when 'featured-tile' -%}
        {%- liquid
          assign tile_mobile_url = blank
          assign tile_desktop_url = blank
          assign tile_bg_position = blank
          if block.settings.image
            assign tile_mobile_url = block.settings.image | image_url: width: 400
            assign tile_desktop_url = block.settings.image | image_url: width: 700
            assign tile_focal_point = block.settings.image.presentation.focal_point
            if tile_focal_point
              assign tile_bg_position = tile_focal_point.x | append: '% ' | append: tile_focal_point.y | append: '%'
            endif
          endif
        -%}
        <a
          href="{{ block.settings.link.url | default: routes.all_products_collection_url }}"
          class="mega-menu__tile"
          {% if block.settings.image %}style="--bg-mobile:url({{ tile_mobile_url }});--bg-desktop:url({{ tile_desktop_url }}){% if tile_bg_position %};--bg-position:{{ tile_bg_position }}{% endif %}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="mega-menu__tile-label">
            <span class="eyebrow" style="color:#ddd">{{ block.settings.eyebrow }}</span>
            <span style="display:block;font-family:var(--font-display);text-transform:uppercase;font-size:14px;margin-top:4px">
              {{ block.settings.label }}
            </span>
          </span>
        </a>
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Mega-menu",
  "settings": [
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Top-level menu label this panel opens under",
      "info": "Must exactly match one top-level link's text in the header's main menu (e.g. \"Shop\").",
      "default": "Shop"
    }
  ],
  "blocks": [
    {
      "type": "menu-column",
      "name": "Menu column",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Column" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "featured-tile",
      "name": "Featured tile",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Arrival" },
        { "type": "text", "id": "label", "label": "Label", "default": "Featured product" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega-menu",
      "blocks": [
        { "type": "menu-column", "settings": { "heading": "Carry" } },
        { "type": "menu-column", "settings": { "heading": "Shelter & Camp" } },
        { "type": "menu-column", "settings": { "heading": "Apparel" } },
        { "type": "featured-tile" }
      ]
    }
  ]
}
{% endschema %}
