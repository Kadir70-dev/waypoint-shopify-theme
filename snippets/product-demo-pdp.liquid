{%- assign demo_altitude = 'demo-altitude-35.png' | asset_url -%}
{%- assign demo_summit = 'demo-summit-45.png' | asset_url -%}
{%- assign demo_ridgeline = 'demo-ridgeline-25.png' | asset_url -%}
{%- assign demo_range = 'demo-range-32.png' | asset_url -%}
{%- assign demo_jaakari = 'demo-jaakari-30.png' | asset_url -%}
{%- assign demo_colors = 'RANGER GREEN|CHARCOAL|COYOTE|BLACK' | split: '|' -%}
{%- assign demo_capacities = '25L|35L|45L' | split: '|' -%}
<div class="aera-demo-pdp" data-demo-pdp>
  <div class="aera-demo-pdp__gallery">
    <div class="aera-demo-pdp__thumbs" role="tablist" aria-label="Product gallery">
      {%- assign demo_gallery = demo_altitude | append: '|' | append: demo_summit | append: '|' | append: demo_ridgeline | append: '|' | append: demo_range | append: '|' | append: demo_jaakari | split: '|' -%}
      {%- for image in demo_gallery -%}<button type="button" class="aera-demo-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-demo-pdp-thumb data-image="{{ image }}" aria-selected="{{ forloop.first }}" role="tab" aria-label="View product image {{ forloop.index }}"><img src="{{ image }}" alt="" loading="lazy" width="1254" height="1254"></button>{%- endfor -%}
    </div>
    <div class="aera-demo-pdp__stage">
      <img src="{{ demo_altitude }}" alt="ALTITUDE 35 backpack in Ranger Green" data-demo-pdp-main width="1254" height="1254">
      <div class="aera-demo-pdp__controls"><div>{%- for image in demo_gallery -%}<button type="button" class="aera-demo-pdp__counter{% if forloop.first %} is-active{% endif %}" data-demo-pdp-counter="{{ forloop.index0 }}">0{{ forloop.index }}</button>{%- endfor -%}</div><button type="button" class="aera-demo-pdp__expand" data-demo-pdp-expand aria-label="Expand product image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M21 16v5h-5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button></div>
    </div>
  </div>
  <div class="aera-demo-pdp__info">
    <span class="eyebrow">TACTICAL BACKPACK</span>
    <h1>ALTITUDE 35<br>BACKPACK</h1>
    <p class="aera-demo-pdp__tagline">Go further. Carry better.</p>
    <p class="aera-demo-pdp__description">A technical 35L backpack built for demanding terrain<br>and unpredictable conditions. Engineered for explorers<br>who move with purpose.</p>
    <div class="aera-demo-pdp__price-row"><strong>€229,00</strong><span aria-label="4.8 out of 5 stars">★★★★★ <b>4.8</b> <em>(124 reviews)</em></span></div>
    <div class="aera-demo-pdp__rule"></div>
    <fieldset class="aera-demo-pdp__choice"><legend class="eyebrow">COLOUR: <span data-demo-color-label>RANGER GREEN</span></legend><div>{%- for color in demo_colors -%}<button type="button" class="aera-demo-pdp__color{% if forloop.first %} is-active{% endif %}" data-demo-color="{{ color }}" aria-label="{{ color }}" aria-pressed="{{ forloop.first }}"><span></span></button>{%- endfor -%}</div></fieldset>
    <fieldset class="aera-demo-pdp__choice"><legend class="eyebrow">CAPACITY</legend><div>{%- for size in demo_capacities -%}<button type="button" class="aera-demo-pdp__capacity{% if size == '35L' %} is-active{% endif %}" data-demo-capacity="{{ size }}" aria-pressed="{% if size == '35L' %}true{% else %}false{% endif %}">{{ size }}</button>{%- endfor -%}</div></fieldset>
    {%- form 'product', product, class: 'aera-demo-pdp__form', data-cart-add-form: true -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}"><div class="aera-demo-pdp__purchase"><div class="aera-demo-pdp__quantity"><button type="button" data-demo-qty="minus" aria-label="Decrease quantity">−</button><input type="number" name="quantity" value="1" min="1" data-demo-qty-input aria-label="Quantity"><button type="button" data-demo-qty="plus" aria-label="Increase quantity">+</button></div><button type="submit" class="aera-demo-pdp__add">ADD TO CART <span>→</span></button></div>
    {%- endform -%}
    <div class="aera-demo-pdp__trust"><span>{%- render 'icon-truck' -%} Free EU shipping over €100</span><i></i><span>30 day returns</span></div>
  </div>
</div>
<script>
  document.querySelectorAll('[data-demo-pdp]').forEach(function (root) {
    var main = root.querySelector('[data-demo-pdp-main]');
    var thumbs = Array.from(root.querySelectorAll('[data-demo-pdp-thumb]'));
    var counters = Array.from(root.querySelectorAll('[data-demo-pdp-counter]'));
    function show(index) { thumbs.forEach(function (el, i) { var active = i === index; el.classList.toggle('is-active', active); el.setAttribute('aria-selected', active); counters[i].classList.toggle('is-active', active); if (active) main.src = el.dataset.image; }); }
    thumbs.forEach(function (el, i) { el.addEventListener('click', function () { show(i); }); });
    counters.forEach(function (el, i) { el.addEventListener('click', function () { show(i); }); });
    root.querySelectorAll('[data-demo-color]').forEach(function (el) { el.addEventListener('click', function () { root.querySelectorAll('[data-demo-color]').forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); }); el.classList.add('is-active'); el.setAttribute('aria-pressed', 'true'); root.querySelector('[data-demo-color-label]').textContent = el.dataset.demoColor; }); });
    root.querySelectorAll('[data-demo-capacity]').forEach(function (el) { el.addEventListener('click', function () { root.querySelectorAll('[data-demo-capacity]').forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); }); el.classList.add('is-active'); el.setAttribute('aria-pressed', 'true'); }); });
    var qty = root.querySelector('[data-demo-qty-input]'); root.querySelectorAll('[data-demo-qty]').forEach(function (el) { el.addEventListener('click', function () { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + (el.dataset.demoQty === 'plus' ? 1 : -1)); }); });
    root.querySelector('[data-demo-pdp-expand]').addEventListener('click', function () { if (root.querySelector('.aera-demo-pdp__stage').requestFullscreen) root.querySelector('.aera-demo-pdp__stage').requestFullscreen(); });
  });
</script>
