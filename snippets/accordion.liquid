{%- comment -%}
  Usage: {% render 'accordion', title: block.settings.title, content: block.settings.content, open: false %}
  Native <details>/<summary> — expand/collapse and keyboard support come
  free from the browser, no JS required.
{%- endcomment -%}
<details class="accordion" {% if open %}open{% endif %}>
  <summary class="accordion__trigger">
    <span>{{ title }}</span>
    {%- render 'icon-plus' -%}
  </summary>
  <div class="accordion__content">{{ content }}</div>
</details>
