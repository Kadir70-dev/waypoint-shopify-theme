{%- comment -%}
  Usage: {% render 'free-shipping-bar' %}
  Reads the real settings.show_free_shipping_bar / settings.free_shipping_threshold
  (Milestone 0 Cart settings) and the live cart total — no fabricated copy
  or thresholds. Renders nothing if the merchant has the bar switched off,
  or if the threshold is unset/zero.
{%- endcomment -%}
{%- if settings.show_free_shipping_bar and settings.free_shipping_threshold > 0 -%}
  {%- assign threshold_cents = settings.free_shipping_threshold | times: 100 -%}
  {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
  {%- assign progress_percent = cart.total_price | times: 100 | divided_by: threshold_cents -%}
  {%- if progress_percent > 100 -%}{%- assign progress_percent = 100 -%}{%- endif -%}
  <div class="free-shipping-bar" data-free-shipping-bar>
    <p class="free-shipping-bar__message" data-free-shipping-message>
      {%- if remaining_cents <= 0 -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- else -%}
        {%- assign remaining_formatted = remaining_cents | money -%}
        {{ 'cart.free_shipping_progress' | t: amount: remaining_formatted }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track">
      <div class="free-shipping-bar__fill" data-free-shipping-fill style="width: {{ progress_percent }}%"></div>
    </div>
  </div>
{%- endif -%}
