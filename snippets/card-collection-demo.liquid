{%- liquid
  assign demo_href = routes.all_products_collection_url
  if title == 'ALTITUDE 35'
    assign demo_href = '/products/aera-altitude-35'
  endif
-%}
<article class="pcard collection-demo-card" data-category="{{ category }}" data-capacity="{{ capacity }}" data-colors="{{ product_colors }}" data-features="{{ features }}" data-activities="{{ activities }}">
  <a class="pcard__link" href="{{ demo_href }}" aria-label="Demo presentation: {{ title }}">
    <div class="pcard__media">
      {%- if badge != blank -%}<span class="pcard__badge">{{ badge }}</span>{%- endif -%}
      <img src="{{ image | asset_url }}" alt="{{ title | escape }}" loading="lazy" width="1254" height="1254">
    </div>
    <div class="pcard__body"><h3 class="pcard__name">{{ title }}</h3><p class="pcard__excerpt">{{ description }}</p><p class="pcard__price">{{ price }}</p><div class="pcard__footer"><div class="pcard__swatches" aria-label="Demo color options">{%- for color in colors -%}<span class="swatch" style="background-color:{{ color }}"></span>{%- endfor -%}</div></div></div>
  </a>
</article>
