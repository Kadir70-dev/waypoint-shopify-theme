{%- comment -%}
  Usage: {% render 'card-product', product: product %}
  or: {% render 'card-product', product: product, plain: true %}
  (plain = the plain-photography validation frame, not tied to any
  merchant setting — used where the theme wants to demonstrate/force it)

  Quick-add: a real form POST to /cart/add — works with zero JS. Milestone
  5's cart.js progressively enhances it (data-cart-add-form): intercepts
  the submit, adds via /cart/add.js, and opens the cart drawer as
  confirmation instead of navigating.
{%- endcomment -%}
{%- if false -%}{%- render 'card-product-demo', image: '', title: '', price: '' -%}{%- endif -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign badge_text = blank
  assign badge_muted = false
  assign badge_kind = blank
  if variant.available == false
    assign badge_text = 'products.sold_out' | t
    assign badge_muted = true
    assign badge_kind = 'muted'
  elsif settings.show_badges and variant.compare_at_price > variant.price
    assign badge_text = 'products.badge_sale' | t
    assign badge_kind = 'sale'
  elsif settings.show_badges
    assign badge_map = settings.badge_tag_map | default: 'new:New,bestseller:Bestseller,limited:Limited,exclusive:Exclusive'
    assign badge_rules = badge_map | split: ','
    for badge_rule in badge_rules
      assign badge_parts = badge_rule | split: ':'
      assign badge_tag = badge_parts[0] | strip
      assign badge_label = badge_parts[1] | strip
      if badge_tag != blank and product.tags contains badge_tag
        assign badge_text = badge_label
        assign badge_kind = badge_tag | handleize
        break
      endif
    endfor
  endif
  assign swatch_option_name = settings.product_card_swatch_option | default: 'Color'
  assign color_option = product.options_with_values | where: 'name', swatch_option_name | first
  assign secondary_image = blank
  assign image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
      if image_count == 2
        assign secondary_image = media
        break
      endif
    endif
  endfor
-%}

<div class="pcard{% if plain %} pcard--plain{% endif %} pcard--ratio-{{ settings.product_card_ratio | default: 'square' }}" data-reveal>
  <a href="{{ product.url }}" class="pcard__media">
    {%- if product.featured_image -%}
      {%- assign focal_point = product.featured_image.presentation.focal_point -%}
      {%- assign focal_style = 'object-position: ' | append: focal_point.x | append: '% ' | append: focal_point.y | append: '%' -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', style: focal_style }}
      {%- if settings.show_product_card_secondary_image and secondary_image != blank -%}
        {{ secondary_image | image_url: width: 600 | image_tag: class: 'pcard__secondary-image', loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pcard__placeholder' }}
    {%- endif -%}
    {%- if badge_text != blank -%}
      <span class="badge pcard__badge{% if badge_muted %} badge--muted{% endif %}{% if badge_kind != blank %} badge--{{ badge_kind }}{% endif %}">{{ badge_text }}</span>
    {%- endif -%}
  </a>

  {%- if settings.show_quick_add and variant.available -%}
    {%- if product.has_only_default_variant -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="pcard__quickadd-form" data-cart-add-form>
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" class="pcard__quickadd" aria-label="{{ 'products.quick_add' | t }}: {{ product.title }}">
          {%- render 'icon-plus' -%}
        </button>
      </form>
    {%- else -%}
      <button type="button" class="pcard__quickadd" data-quick-add-trigger data-product-url="{{ product.url }}" aria-haspopup="dialog" aria-controls="QuickAddDialog" aria-label="{{ 'products.quick_add' | t }}: {{ product.title }}">
        {%- render 'icon-plus' -%}
      </button>
    {%- endif -%}
  {%- endif -%}

  <div class="pcard__body">
    <a href="{{ product.url }}" class="pcard__name">{{ product.title }}</a>
    {%- if collection_context and product.description != blank -%}<p class="pcard__excerpt">{{ product.description | strip_html | truncatewords: 10 }}</p>{%- endif -%}
    {%- render 'price', product: product -%}
    {%- render 'star-rating', product: product -%}
    {%- if color_option -%}
      <div class="pcard__swatches">
        {%- for value in color_option.values -%}
          {%- if value.swatch.image -%}
            {%- assign swatch_image_url = value.swatch.image | image_url: width: 32 -%}
            <span class="swatch" style="background-image:url({{ swatch_image_url }});background-size:cover" title="{{ value }}"></span>
          {%- elsif value.swatch.color -%}
            <span class="swatch" style="background:{{ value.swatch.color }}" title="{{ value }}"></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
