{%- comment -%}
  Usage: {% render 'predictive-search-results', results: predictive_search.resources.results, terms: predictive_search.terms, has_results: has_results %}
  Shared by sections/predictive-search.liquid (live API) and the preview
  harness (static mock) — real photography/tokens only, no custom markup
  invented here that the rest of the site doesn't already use.
{%- endcomment -%}
{%- if has_results -%}
  <div class="predictive-search__groups">
    {%- if results.products.size > 0 -%}
      <div class="predictive-search__group">
        <div class="eyebrow">{{ 'search.products' | t }}</div>
        <ul class="predictive-search__product-list">
          {%- for product in results.products -%}
            <li>
              <a href="{{ product.url }}" class="predictive-search__product">
                <span class="predictive-search__product-media">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title, width: 40, height: 40 }}
                  {%- endif -%}
                </span>
                <span class="predictive-search__product-body">
                  <span class="predictive-search__product-name">{{ product.title }}</span>
                  {%- render 'price', product: product -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if results.collections.size > 0 -%}
      <div class="predictive-search__group">
        <div class="eyebrow">{{ 'search.collections' | t }}</div>
        <ul class="predictive-search__link-list">
          {%- for collection in results.collections -%}
            <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if results.articles.size > 0 -%}
      <div class="predictive-search__group">
        <div class="eyebrow">{{ 'search.articles' | t }}</div>
        <ul class="predictive-search__link-list">
          {%- for article in results.articles -%}
            <li><a href="{{ article.url }}">{{ article.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>

  <a href="{{ routes.search_url }}?q={{ terms | url_encode }}&amp;type=product" class="predictive-search__view-all">
    {{ 'search.view_all_results' | t: terms: terms }} &rarr;
  </a>
{%- else -%}
  <div class="predictive-search__empty">
    <svg class="empty-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.3">
      <circle cx="27" cy="27" r="16"/><path d="M39 39 L54 54"/>
    </svg>
    <p style="font-size:14px">{{ 'search.no_results' | t: terms: terms }}</p>
    <p class="muted" style="font-size:12px">{{ 'search.no_results_text' | t }}</p>
  </div>
{%- endif -%}
