<div class="pcard" data-reveal>
  <a href="{{ routes.all_products_collection_url }}" class="pcard__media">
    <img src="{{ image | asset_url }}" width="329" height="355" loading="lazy" alt="{{ title | escape }}">
  </a>
  <div class="pcard__body">
    <a href="{{ routes.all_products_collection_url }}" class="pcard__name">{{ title }}</a>
    <span class="pcard__price">{{ price }}</span>
    {%- if swatches != blank -%}
      <div class="pcard__swatches">
        {%- assign colors = swatches | split: ',' -%}
        {%- for color in colors -%}<span class="swatch" style="background:{{ color | strip }}" aria-hidden="true"></span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
