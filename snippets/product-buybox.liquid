{%- comment -%}
  Usage: {% render 'product-buybox', product: product, current_variant: current_variant, section: section %}
  This is the fragment re-fetched via the Section Rendering API on
  variant change (?variant=<id>&section_id=main-product) — keep it free
  of anything that shouldn't be re-rendered (the gallery lives outside
  this snippet for that reason).
{%- endcomment -%}
<span class="eyebrow">{{ product.type | default: product.vendor }}</span>
<h1 class="product-buybox__title">{{ product.title }}</h1>
{%- render 'star-rating', product: product -%}
{%- render 'price', product: product, variant: current_variant -%}
{%- if cart.taxes_included -%}<p class="product-buybox__tax-note">{{ 'products.tax_included' | t }}</p>{%- endif -%}

{%- if current_variant.available == false -%}
  <span class="badge" style="margin-top:6px">{{ 'products.sold_out' | t }}</span>
{%- endif -%}

{%- comment -%}
  Local pickup availability (Milestone 10, Theme Store requirement).
  Real store_availabilities data only — renders nothing if the merchant
  has no locations with local pickup enabled. Shows the nearest
  pickup-enabled location's real status/time; a proportionate summary
  rather than a full multi-location picker/modal, since none of the
  existing overlay components in this theme were built for that and
  this milestone shouldn't introduce a new one for a single field.
{%- endcomment -%}
{%- assign pickup_locations = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
{%- if pickup_locations.size > 0 -%}
  {%- assign nearest_pickup = pickup_locations.first -%}
  <div class="product-buybox__pickup" style="font-size:13px;color:var(--muted);margin-top:6px">
    {%- if nearest_pickup.available -%}
      <p>{{ 'products.pickup_available' | t: location: nearest_pickup.location.name }}</p>
      {%- if nearest_pickup.pick_up_time != blank -%}
        <p>{{ 'products.pickup_time' | t: time: nearest_pickup.pick_up_time }}</p>
      {%- endif -%}
    {%- else -%}
      <p>{{ 'products.pickup_unavailable' | t: location: nearest_pickup.location.name }}</p>
    {%- endif -%}
    {%- assign other_location_count = pickup_locations.size | minus: 1 -%}
    {%- if other_location_count == 1 -%}
      <p>{{ 'products.pickup_other_locations_one' | t: count: other_location_count }}</p>
    {%- elsif other_location_count > 1 -%}
      <p>{{ 'products.pickup_other_locations_other' | t: count: other_location_count }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- assign size_chart_block = section.blocks | where: 'type', 'size_chart' | first -%}
{%- assign has_size_chart = false -%}
{%- if size_chart_block and size_chart_block.settings.page != blank -%}
  {%- assign has_size_chart = true -%}
{%- elsif size_chart_block and size_chart_block.settings.content != blank -%}
  {%- assign has_size_chart = true -%}
{%- endif -%}
{%- assign product_form_id = 'ProductForm-' | append: section.id -%}
{%- form 'product', product, class: 'product-buybox__form', id: product_form_id, data-cart-add-form: true -%}
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-form-variant-id>

  {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}
    <fieldset class="option-selector">
      <legend class="eyebrow">
        {{ option.name }}: <span data-option-selected-value>{{ option.selected_value }}</span>
        {%- if has_size_chart and option.name == 'Size' -%}
          <button type="button" class="product-size-chart__trigger" data-size-chart-trigger aria-haspopup="dialog" aria-controls="SizeChartDialog-{{ section.id }}">
            {%- render 'icon-ruler' -%} {{ 'products.size_chart' | t }}
          </button>
        {%- endif -%}
      </legend>
      <div class="option-selector__values">
        {%- for value in option.values -%}
          {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
          <input
            type="radio"
            id="{{ input_id }}"
            name="option-{{ option.position }}"
            value="{{ value | escape }}"
            {% if value == option.selected_value %}checked{% endif %}
            data-option-position="{{ option.position }}"
            class="visually-hidden option-selector__input"
          >
          {%- if option.name == 'Color' and value.swatch.image -%}
            {%- assign swatch_image_url = value.swatch.image | image_url: width: 64 -%}
            <label for="{{ input_id }}" class="option-selector__swatch" data-option-label style="background-image:url({{ swatch_image_url }});background-size:cover" title="{{ value }}">
              <span class="visually-hidden">{{ value }}<span data-unavailable-tag hidden> — {{ 'products.option_unavailable' | t }}</span></span>
            </label>
          {%- elsif option.name == 'Color' and value.swatch.color -%}
            <label for="{{ input_id }}" class="option-selector__swatch" data-option-label style="background:{{ value.swatch.color }}" title="{{ value }}">
              <span class="visually-hidden">{{ value }}<span data-unavailable-tag hidden> — {{ 'products.option_unavailable' | t }}</span></span>
            </label>
          {%- else -%}
            <label for="{{ input_id }}" class="option-selector__pill" data-option-label>
              {{- value -}}
              <span class="visually-hidden" data-unavailable-tag hidden> — {{ 'products.option_unavailable' | t }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}{%- endunless -%}

  {%- comment -%}
    App-managed pre-orders and purchase plans. Shopify owns the selling plans,
    delivery/billing policies, and the final checkout. Render exactly one
    selling_plan radio group for the currently selected variant; selecting
    an option submits its actual Shopify selling plan ID, including without JS.
    The Section Rendering API refreshes this markup on variant changes.
  {%- endcomment -%}
  {%- liquid
    assign purchase_requires_plan = product.requires_selling_plan
    if current_variant.requires_selling_plan
      assign purchase_requires_plan = true
    endif
    assign purchase_allocations = current_variant.selling_plan_allocations
    assign purchase_ready = current_variant.available
    if purchase_requires_plan and purchase_allocations.size == 0
      assign purchase_ready = false
    endif
  -%}
  {%- if purchase_allocations.size > 0 -%}
    <fieldset class="purchase-options" data-purchase-options>
      <legend class="purchase-options__heading">Purchase options</legend>
      <div class="purchase-options__choices">
        {%- unless purchase_requires_plan -%}
          <label class="purchase-options__choice">
            <input type="radio" name="selling_plan" value="" checked>
            <span class="purchase-options__name">One-time purchase</span>
            <span class="purchase-options__price">{{ current_variant.price | money }}</span>
          </label>
        {%- endunless -%}
        {%- for allocation in purchase_allocations -%}
          <label class="purchase-options__choice">
            <input type="radio" name="selling_plan" value="{{ allocation.selling_plan.id }}"{% if purchase_requires_plan and forloop.first %} checked{% endif %}>
            <span class="purchase-options__name">{{ allocation.selling_plan.name | escape }}</span>
            <span class="purchase-options__price">{{ allocation.price | money }}</span>
          </label>
        {%- endfor -%}
      </div>
      <p class="purchase-options__note">Delivery schedule, charges and cancellation terms are set by the merchant's purchase-option app and shown at checkout.</p>
    </fieldset>
  {%- elsif purchase_requires_plan -%}
    <p class="purchase-options__unavailable" role="status">This product needs a configured purchase option before checkout is available.</p>
  {%- endif -%}

  <div class="product-buybox__quantity">
    <label for="Quantity-{{ section.id }}" class="eyebrow">{{ 'products.quantity' | t }}</label>
    <div class="quantity-stepper">
      <button type="button" class="quantity-stepper__btn" data-quantity-decrease aria-label="{{ 'products.decrease_quantity' | t }}" aria-controls="Quantity-{{ section.id }}">&minus;</button>
      <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
      <button type="button" class="quantity-stepper__btn" data-quantity-increase aria-label="{{ 'products.increase_quantity' | t }}" aria-controls="Quantity-{{ section.id }}">+</button>
    </div>
  </div>

  {%- if product.gift_card? -%}
    {%- comment -%}
      Native gift-card recipient fields (Milestone 10, Theme Store
      requirement). Deliberately always visible (no JS-dependent show/
      hide) so the form is fully correct with JS disabled — Shopify's
      own server-side validation only requires the recipient fields when
      __shopify_send_gift_card_to_recipient is checked, so an unchecked,
      empty form still submits correctly. Real field names only, per
      Shopify's documented gift-card recipient API. Per that same
      documentation, accelerated checkout does not support recipient
      validation, so payment_button is intentionally skipped below for
      gift card products.
    {%- endcomment -%}
    <fieldset class="product-buybox__gift-recipient" style="display:flex;flex-direction:column;gap:10px;border:1px solid var(--border-strong);padding:14px;margin-top:4px">
      <label style="display:flex;align-items:center;gap:8px;font-size:13px">
        <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="true" data-gift-card-recipient-checkbox>
        {{ 'gift_card.recipient.checkbox_label' | t }}
      </label>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div class="buybox-field">
          <label for="GiftCardRecipientEmail-{{ section.id }}" class="eyebrow">{{ 'gift_card.recipient.email_label' | t }}</label>
          <input type="email" id="GiftCardRecipientEmail-{{ section.id }}" name="properties[Recipient email]">
        </div>
        <div class="buybox-field">
          <label for="GiftCardRecipientName-{{ section.id }}" class="eyebrow">{{ 'gift_card.recipient.name_label' | t }}</label>
          <input type="text" id="GiftCardRecipientName-{{ section.id }}" name="properties[Recipient name]">
        </div>
        <div class="buybox-field">
          <label for="GiftCardRecipientMessage-{{ section.id }}" class="eyebrow">{{ 'gift_card.recipient.message_label' | t }}</label>
          <textarea id="GiftCardRecipientMessage-{{ section.id }}" name="properties[Message]" rows="2"></textarea>
        </div>
        <div class="buybox-field">
          <label for="GiftCardRecipientSendOn-{{ section.id }}" class="eyebrow">{{ 'gift_card.recipient.send_on_label' | t }}</label>
          <input type="date" id="GiftCardRecipientSendOn-{{ section.id }}" name="properties[Send on]">
          <span class="muted" style="font-size:11px">{{ 'gift_card.recipient.send_on_info' | t }}</span>
        </div>
      </div>
    </fieldset>
  {%- endif -%}

  <button
    type="submit"
    class="btn btn-primary btn-block"
    data-product-form-submit
    data-label-add="{{ 'products.add_to_cart' | t }}"
    data-label-sold-out="{{ 'products.sold_out' | t }}"
    data-label-adding="{{ 'products.adding' | t }}"
    data-label-added="{{ 'products.added' | t }}"
    {% unless purchase_ready %}disabled{% endunless %}
  >
    {%- if purchase_ready -%}
      {{ 'products.add_to_cart' | t }} &rarr;
    {%- else -%}
      {{ 'products.sold_out' | t }}
    {%- endif -%}
  </button>

  {%- comment -%}
    Accelerated checkout + Shop Pay Installments (Milestone 10, Theme
    Store requirements). payment_button is skipped for gift cards per
    Shopify's own documented incompatibility with recipient validation.
  {%- endcomment -%}
  {%- comment -%}Pre-order purchase plans do not support accelerated checkout buttons.{%- endcomment -%}
  {%- unless product.gift_card? -%}
    {%- if product.selling_plan_groups.size == 0 -%}
      {{ form | payment_button }}
    {%- endif -%}
  {%- endunless -%}
  {{ form | payment_terms }}

  {%- if settings.show_free_shipping_bar -%}
    {%- assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
    <p class="product-buybox__shipping-note">
      {{ 'products.free_shipping_over' | t: amount: free_shipping_amount }}
    </p>
  {%- endif -%}
{%- endform -%}

{%- if current_variant.available == false -%}
  {%- comment -%}
    Frontend capture only — Shopify has no native "email on restock"
    delivery mechanism. This creates/updates a real Customer record via
    the native customer form (same mechanism as newsletter.liquid),
    tagged with the specific product+variant so a merchant-configured
    Shopify Flow or a back-in-stock app can act on it. The theme itself
    cannot send the notification — see Module 12 report.
  {%- endcomment -%}
  <div class="back-in-stock" data-back-in-stock>
    {%- form 'customer', class: 'back-in-stock__form' -%}
      <input type="hidden" name="contact[tags]" value="restock-request, restock-{{ product.handle }}-{{ current_variant.id }}">
      {%- if form.posted_successfully? -%}
        <p class="back-in-stock__success" role="status">{{ 'products.back_in_stock_success' | t }}</p>
      {%- else -%}
        <p class="back-in-stock__label">{{ 'products.back_in_stock_prompt' | t }}</p>
        <div class="newsletter-block__row back-in-stock__row">
          <label for="BackInStockEmail-{{ section.id }}" class="visually-hidden">{{ 'products.back_in_stock_email_label' | t }}</label>
          <input type="email" id="BackInStockEmail-{{ section.id }}" name="contact[email]" placeholder="{{ 'products.back_in_stock_email_label' | t }}" required>
          <button type="submit">{{ 'products.back_in_stock_cta' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p role="alert" class="back-in-stock__error">{{ form.errors.messages['contact[email]'] }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}

{%- if has_size_chart -%}
  <dialog id="SizeChartDialog-{{ section.id }}" class="quick-add-dialog size-chart-dialog" aria-label="{{ 'accessibility.size_chart_dialog' | t }}" data-size-chart-dialog>
    <button type="button" class="quick-add-dialog__close icon-btn" data-size-chart-close aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon-close' -%}</button>
    <div class="size-chart-dialog__content rte">
      {%- if size_chart_block.settings.page != blank -%}
        {{ size_chart_block.settings.page.content }}
      {%- else -%}
        {{ size_chart_block.settings.content }}
      {%- endif -%}
    </div>
  </dialog>
{%- endif -%}

{%- if product.description != blank -%}
  <div class="product-buybox__description rte">{{ product.description }}</div>
{%- endif -%}

<div class="visually-hidden" aria-live="polite" data-buybox-status></div>
