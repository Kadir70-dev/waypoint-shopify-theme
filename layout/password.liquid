<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{% assign rtl_locales = 'ar,he,fa,ur' | split: ',' %}{% if rtl_locales contains request.locale.iso_code %}rtl{% else %}ltr{% endif %}"
  data-preset="{{ settings.color_preset | default: 'dark' }}"
  data-corners="{{ settings.corner_style | default: 'sharp' }}"
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ shop.name }}</title>

  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    {{ settings.font_display | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    :root {
      --font-display: {{ settings.font_display.family }}, {{ settings.font_display.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --accent: {{ settings.accent_color }};
    }
  {%- endstyle -%}

  {{ content_for_header }}
</head>
<body>
  <main id="MainContent" tabindex="-1" style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
    <div style="width:100%;max-width:360px;display:flex;flex-direction:column;gap:18px;text-align:center;">
      <h1 class="eyebrow" style="margin:0">{{ shop.name }}</h1>

      {%- if shop.password_message != blank -%}
        <p>{{ shop.password_message }}</p>
      {%- endif -%}

      {%- form 'storefront_password' -%}
        <div style="display:flex;flex-direction:column;gap:6px;text-align:start;">
          <label for="Password" class="eyebrow">
            {{ 'general.password_page.login_form_password_label' | t }}
          </label>
          <input
            type="password"
            name="password"
            id="Password"
            style="background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:12px 14px;font-family:var(--font-body);font-size:14px;"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          >
        </div>
        {%- if form.errors -%}
          <p role="alert">{{ 'general.password_page.login_form_error' | t }}</p>
        {%- endif -%}
        <button
          type="submit"
          style="font-family:var(--font-display);font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px 22px;background:var(--cta-bg);color:var(--cta-text);border:0;cursor:pointer;margin-top:10px;width:100%;"
        >
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      {%- endform -%}
    </div>

    {{ content_for_layout }}
  </main>
</body>
</html>
