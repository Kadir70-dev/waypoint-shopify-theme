<!doctype html>
{%- assign rtl_locales = 'ar,he,fa,ur' | split: ',' -%}
<html
  data-premium-motion="{{ settings.enable_premium_motion }}"
  lang="{{ request.locale.iso_code }}"
  dir="{% if rtl_locales contains request.locale.iso_code %}rtl{% else %}ltr{% endif %}"
  data-preset="{{ settings.color_preset | default: 'dark' }}"
  data-corners="{{ settings.corner_style | default: 'sharp' }}"
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.accent_color | default: '#0E0F0D' }}">

  {%- comment -%}
    Synchronous, before first paint: (1) .js class — [data-reveal] content
    (Milestone 2 scroll-reveal) is visible by default in base.css and only
    animates-in when this class is present, so nothing is ever hidden when
    JavaScript is unavailable. (2) reduced-motion detection — tokens.css's
    @media fallback covers the gap before this executes; motion.js/overlay.js
    read the .reduced-motion class. See Motion Implementation Plan.
  {%- endcomment -%}
  <script>
    (function (html) {
      html.classList.add('js');
      html.classList.add('motion-detected');
      {%- if settings.show_scheme_toggle -%}
      try {
        var savedScheme = localStorage.getItem('waypoint-scheme');
        if (savedScheme === 'dark' || savedScheme === 'daylight') html.setAttribute('data-preset', savedScheme);
      } catch (e) {}
      {%- endif -%}
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        html.classList.add('reduced-motion');
      }
    })(document.documentElement);
  </script>

  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- endif -%}

  {%- comment -%}
    Open Graph + Twitter Card (Milestone 8 SEO). og:image / twitter:image
    fall back to Shopify's page_image (the merchant's Preferences → Social
    sharing image) when the current object has no image of its own. See
    Milestone 8 report, KNOWN LIMITATIONS.
  {%- endcomment -%}
  {%- liquid
    assign og_type = 'website'
    assign og_image = blank
    assign og_description = page_description
    case template
      when 'product'
        assign og_type = 'product'
        assign og_image = product.featured_image
        if og_description == blank
          assign og_description = product.description | strip_html | truncatewords: 30
        endif
      when 'article'
        assign og_type = 'article'
        assign og_image = article.image
        if og_description == blank
          assign og_description = article.excerpt_or_content | strip_html | truncatewords: 30
        endif
      when 'collection'
        assign og_image = collection.image
        if og_description == blank
          assign og_description = collection.description | strip_html | truncatewords: 30
        endif
    endcase
    if og_image == blank and page_image
      assign og_image = page_image
    endif
  -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if og_description != blank -%}
    <meta property="og:description" content="{{ og_description | escape }}">
  {%- endif -%}
  {%- if og_image != blank -%}
    <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta name="twitter:card" content="summary">
  {%- endif -%}
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if og_description != blank -%}
    <meta name="twitter:description" content="{{ og_description | escape }}">
  {%- endif -%}

  {%- comment -%}
    Organization + WebSite structured data (Milestone 8 SEO), site-wide,
    combined under one @graph so only one script tag is ever emitted here
    (Product/BreadcrumbList/Article JSON-LD live in their own templates —
    see main-product.liquid, breadcrumb.liquid, main-article.liquid —
    never duplicated with this block).
  {%- endcomment -%}
  {%- liquid
    assign same_as = ''
    if settings.social_instagram_url != blank
      assign same_as = same_as | append: settings.social_instagram_url | append: ','
    endif
    if settings.social_youtube_url != blank
      assign same_as = same_as | append: settings.social_youtube_url | append: ','
    endif
    if settings.social_spotify_url != blank
      assign same_as = same_as | append: settings.social_spotify_url | append: ','
    endif
    assign same_as_list = same_as | split: ','
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}{% if same_as_list.size > 0 %},
        "sameAs": [{% for url in same_as_list %}{{ url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endif %}
      },
      {
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>

  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'component-nav.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
  {%- if template contains 'collection' or template contains 'search' -%}
    {{ 'component-collection.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- comment -%} Cart drawer starts closed, so off the cart page its CSS loads non-blocking. {%- endcomment -%}
  {%- if template == 'cart' -%}
    {{ 'component-cart.css' | asset_url | stylesheet_tag }}
  {%- else -%}
    <link rel="stylesheet" href="{{ 'component-cart.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'component-cart.css' | asset_url | stylesheet_tag }}</noscript>
  {%- endif -%}
  {%- comment -%}
    component-cart.css stays unconditional — the cart drawer (sections/
    cart-drawer.liquid) is rendered from the header on every page. These
    two are genuinely template-scoped (Milestone 8 performance fix: they
    used to load site-wide for no reason).
  {%- endcomment -%}
  {%- comment -%}
    'page' matched via contains, not ==, so it also covers alternate
    page templates like page.contact (Milestone 10 fix — page.contact
    didn't match the old == 'page' check, so its .rte content lost this
    stylesheet on that template). 'product' added: the PDP's own
    rich-text description now uses the same .rte class (Milestone 10
    RTE-consistency fix) and needs these rules to actually render.
  {%- endcomment -%}
  {%- if template == 'index' or template == 'blog' or template == 'article' or template contains 'page' or template == 'product' -%}
    {{ 'component-editorial.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template contains 'customers' -%}
    {{ 'component-account.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- comment -%} component-motion.css is loaded by the sections that use it (hero-slider, testimonial-carousel, social-proof). {%- endcomment -%}
  {{ 'component-ios.css' | asset_url | stylesheet_tag }}
  {{ 'component-premium.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    Typography / font-picker architecture. Self-hosted via Shopify's native
    font_picker (Foundation decision — no external Google Fonts request).
    Closest premium matches to the approved Waypoint type system: a condensed
    bold display face, a clean body sans, and an italic editorial serif.
  {%- endcomment -%}
  {%- style -%}
    {{ settings.font_display | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_editorial | font_face: font_display: 'swap' }}

    :root {
      --font-display: {{ settings.font_display.family }}, {{ settings.font_display.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-editorial: {{ settings.font_editorial.family }}, {{ settings.font_editorial.fallback_families }};
      --page-width: {{ settings.page_width }}px;
      --type-scale: {{ settings.type_scale | default: 100 | divided_by: 100.0 }};
      {%- comment -%}
        Module 01 fix: settings.spacing_scale existed since Milestone 0
        and even differs between the two presets, but was never actually
        read anywhere — --space-unit stayed hardcoded at 8px in
        tokens.css regardless. Wiring it here is what makes base.css's
        --space-unit-driven section/page-width rhythm (and therefore the
        Daylight preset's airier spacing) real instead of a no-op.
      {%- endcomment -%}
      --space-unit: {{ settings.spacing_scale | default: 100 | times: 8 | divided_by: 100.0 }}px;
    }

    {%- comment -%}
      [data-preset] (not bare :root) is required here: tokens.css defines
      Daylight's own --accent on the more-specific :root[data-preset=
      "daylight"] selector, which would otherwise beat a plain :root
      override here regardless of source order and silently no-op
      accent_color on that preset (Milestone 9 fix — previously only
      worked correctly on the Dark preset).
    {%- endcomment -%}
    :root[data-preset] {
      --accent: {{ settings.accent_color }};
      {%- if settings.color_background != blank -%}--bg: {{ settings.color_background }};{%- endif -%}
      {%- if settings.color_text != blank -%}--text: {{ settings.color_text }};{%- endif -%}
      {%- if settings.color_surface != blank -%}--surface: {{ settings.color_surface }};--surface-2: {{ settings.color_surface }};{%- endif -%}
      {%- if settings.color_button != blank -%}--cta-bg: {{ settings.color_button }};{%- endif -%}
      {%- if settings.color_button_text != blank -%}--cta-text: {{ settings.color_button_text }};{%- endif -%}
    }
  {%- endstyle -%}

  {{ content_for_header }}
</head>

<body data-has-tabbar="true">
  <a class="skip-link" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  {%- sections 'header-group' -%}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  {%- render 'quick-add-dialog' -%}

  <script src="{{ 'overlay.js' | asset_url }}" defer></script>
  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  {%- if template contains 'product' -%}
    <script src="{{ 'variant-picker.js' | asset_url }}" defer></script>
    <script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
    <script src="{{ 'size-chart.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template contains 'collection' or template contains 'search' -%}
    <script src="{{ 'collection-facets.js' | asset_url }}" defer></script>
  {%- endif -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>
  <script src="{{ 'mobile-nav.js' | asset_url }}" defer></script>
  {%- if template contains 'customers' -%}
    <script src="{{ 'account.js' | asset_url }}" defer></script>
  {%- endif -%}
  <script src="{{ 'motion.js' | asset_url }}" defer></script>
  {%- if settings.enable_premium_motion != false -%}
    <script src="{{ 'premium-motion.js' | asset_url }}" defer></script>
  {%- endif -%}
</body>
</html>
